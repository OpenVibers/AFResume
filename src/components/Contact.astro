---
import profile from "../data/profile.json";
---
<section class="section contact" id="contact" aria-labelledby="contact-title">
  <div class="container">
    <div class="ct card spot" data-reveal="scale">
      <div class="ct__glow" aria-hidden="true"></div>
      <div class="ct__grid">
        <div>
          <div class="sec-index">Contact</div>
          <h2 class="ct__title" id="contact-title">I build <span class="grad-text ct-cycle" id="ct-cycle" data-words={JSON.stringify(profile.capabilities)}>{profile.capabilities[0]}</span>.</h2>
          <p class="ct__lead">Web and software engineering, guru-level: I'm the person you call whether it's a landing page or a live-streaming platform — I design it, build it and keep it running. {profile.availability}. I answer email fastest.</p>
          <div class="ct__actions">
            <a class="btn btn--primary" href={`mailto:${profile.email}`} data-magnetic><i class="fa-solid fa-envelope"></i> {profile.emailDisplay}</a>
            <button class="btn" data-copy={profile.email} data-magnetic><i class="fa-regular fa-copy"></i> <span>Copy email</span></button>
            <a class="btn btn--ghost" href={`tel:${profile.phone}`} data-magnetic><i class="fa-solid fa-phone"></i> {profile.phoneDisplay}</a>
          </div>
        </div>
        <ul class="ct__social">
          <li><a href={profile.github} target="_blank" rel="me noopener"><i class="fa-brands fa-github"></i><span>GitHub</span><small>{profile.githubDisplay}</small></a></li>
          <li><a href={profile.linkedin} target="_blank" rel="me noopener"><i class="fa-brands fa-linkedin-in"></i><span>LinkedIn</span><small>{profile.linkedinDisplay}</small></a></li>
          <li><a href="https://openvibe.live" target="_blank" rel="noopener"><i class="fa-solid fa-tower-broadcast"></i><span>OpenVibe</span><small>openvibe.live</small></a></li>
          <li><a href={profile.resumePdf}><i class="fa-solid fa-file-pdf"></i><span>Resume</span><small>PDF, two pages</small></a></li>
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .ct { overflow: hidden; padding: clamp(28px, 5vw, 60px); }
  .ct__glow { position: absolute; inset: -40% -20% auto auto; width: 60%; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(closest-side, rgba(var(--accent-rgb), .35), transparent 70%); filter: blur(30px); animation: breathe 9s ease-in-out infinite; pointer-events: none; }
  @keyframes breathe { 50% { transform: scale(1.15) translate(-6%, 8%); opacity: .7; } }
  .ct__grid { position: relative; display: grid; grid-template-columns: 1.3fr 1fr; gap: clamp(24px, 4vw, 56px); align-items: center; }
  .ct__title { font-size: clamp(2rem, 4.4vw, 3.4rem); margin: 8px 0 14px; max-width: 20ch; }
  .ct-cycle { display: inline-block; min-width: 1ch; }
  .ct__lead { font-size: 1.05rem; max-width: 52ch; }
  .ct__actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 22px; }
  .ct__social { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .ct__social a {
    display: grid; grid-template-columns: 44px 1fr; grid-template-rows: auto auto; column-gap: 14px; align-items: center;
    padding: 12px 14px; border-radius: 16px; border: 1px solid var(--border); background: var(--surface);
    color: var(--fg); text-decoration: none; transition: all .35s var(--ease);
  }
  .ct__social a:hover { border-color: rgba(var(--accent-rgb), .5); transform: translateX(6px); background: var(--surface-2); }
  .ct__social i { grid-row: 1 / span 2; width: 44px; height: 44px; border-radius: 12px; display: inline-grid; place-items: center; font-size: 1.2rem; background: rgba(var(--accent-rgb), .12); color: var(--accent); }
  .ct__social span { font-weight: 600; }
  .ct__social small { color: var(--dim); font-family: var(--font-mono); font-size: .72rem; }
  @media (max-width: 860px) { .ct__grid { grid-template-columns: 1fr; } }
</style>

<script>
  // "I build ___." cycles through everything the site's copy claims elsewhere — one place that
  // says the versatility out loud instead of implying it.
  const cyc = document.getElementById('ct-cycle');
  if (cyc) {
    const words: string[] = JSON.parse(cyc.dataset.words || '[]');
    let i = 0;
    if (words.length > 1 && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      setInterval(() => {
        if (document.hidden) return;
        i = (i + 1) % words.length;
        cyc.animate([{ opacity: 1, transform: 'translateY(0)' }, { opacity: 0, transform: 'translateY(-8px)' }],
          { duration: 220, easing: 'ease-in', fill: 'forwards' }).onfinish = () => {
          cyc.textContent = words[i];
          cyc.animate([{ opacity: 0, transform: 'translateY(8px)' }, { opacity: 1, transform: 'translateY(0)' }],
            { duration: 320, easing: 'cubic-bezier(0.22,1,0.36,1)', fill: 'forwards' });
        };
      }, 2200);
    }
  }

  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => {
    const label = b.querySelector('span')!;
    b.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(b.dataset.copy!); label.textContent = 'Copied!'; }
      catch { label.textContent = b.dataset.copy!; }
      setTimeout(() => (label.textContent = 'Copy email'), 1800);
    });
  });
</script>

---
import profile from "../data/profile.json";
const links = [
  { href: "/#network",    label: "OpenVibe",   id: "network" },
  { href: "/#work",       label: "Work",       id: "work" },
  { href: "/#experience", label: "Experience", id: "experience" },
  { href: "/#skills",     label: "Skills",     id: "skills" },
  { href: "/resume",      label: "Resume",     id: "resume" },
  { href: "/#contact",    label: "Contact",    id: "contact" },
];
const path = Astro.url.pathname;
---
<header class="nav" id="nav">
  <div class="nav__inner">
    <a href="/" class="nav__brand" aria-label="Alex Frison, home">
      <span class="nav__mark" aria-hidden="true">
        <svg viewBox="0 0 40 40" width="34" height="34">
          <defs><linearGradient id="nmg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="var(--accent)"/><stop offset=".55" stop-color="var(--violet)"/><stop offset="1" stop-color="var(--accent-2)"/></linearGradient></defs>
          <rect x="1" y="1" width="38" height="38" rx="11" fill="none" stroke="url(#nmg)" stroke-width="1.5"/>
          <path d="M8 28 L14 12 L20 28 M10.4 22 h7.2" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M24.5 28 V12 H32.5 M24.5 20 H31" fill="none" stroke="url(#nmg)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
      <span class="nav__name">Alex Frison</span>
    </a>

    <nav class="nav__links" aria-label="Primary">
      <ul>
        {links.map((l) => (
          <li><a href={l.href} data-nav={l.id} aria-current={path.startsWith(`/${l.id}`) ? "page" : undefined}>{l.label}</a></li>
        ))}
        <li class="nav__pill" aria-hidden="true"></li>
      </ul>
    </nav>

    <div class="nav__end">
      <a class="nav__cta" href={profile.resumePdf} aria-label="Download resume PDF"><i class="fa-solid fa-arrow-down"></i><span>PDF</span></a>
      <button class="nav__icon" id="nav-color" aria-label="Pick an accent color">
        <i class="fa-solid fa-palette"></i>
      </button>
      <button class="nav__icon" data-theme-toggle aria-label="Toggle light and dark theme">
        <i class="fa-solid fa-sun nav__sun"></i><i class="fa-solid fa-moon nav__moon"></i>
      </button>
      <button class="nav__icon nav__burger" aria-label="Open navigation" aria-expanded="false" aria-controls="nav-drawer">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <div class="nav__drawer" id="nav-drawer" aria-hidden="true">
    <ul>
      {links.map((l, i) => (<li style={`--i:${i}`}><a href={l.href}>{l.label}</a></li>))}
      <li style={`--i:${links.length}`}><a href={profile.resumePdf}>Download PDF</a></li>
    </ul>
  </div>
</header>

<style>
  .nav { position: fixed; top: 0; left: 0; right: 0; z-index: 100; padding: 12px var(--gutter) 0; pointer-events: none; }
  .nav__inner {
    pointer-events: auto;
    max-width: var(--container); margin: 0 auto;
    display: flex; align-items: center; gap: 14px;
    height: 58px; padding: 0 10px 0 12px;
    border-radius: 999px;
    border: 1px solid transparent;
    transition: background .45s var(--ease), border-color .45s var(--ease), box-shadow .45s var(--ease), backdrop-filter .45s;
  }
  .nav.is-scrolled .nav__inner {
    background: color-mix(in oklab, var(--bg) 62%, transparent);
    border-color: var(--border);
    backdrop-filter: blur(22px) saturate(160%);
    -webkit-backdrop-filter: blur(22px) saturate(160%);
    box-shadow: 0 10px 40px -18px rgba(0,0,0,.6), inset 0 1px 0 rgba(255,255,255,.05);
  }
  .nav__brand { display: inline-flex; align-items: center; gap: 10px; color: var(--fg); font-family: var(--font-display); font-weight: 700; letter-spacing: -.01em; text-decoration: none; flex: none; }
  .nav__brand:hover { text-decoration: none; }
  .nav__mark { display: inline-grid; place-items: center; color: var(--fg); transition: transform .5s var(--ease); }
  .nav__brand:hover .nav__mark { transform: rotate(-8deg) scale(1.05); }
  .nav__name { font-size: .98rem; }

  .nav__links { flex: 1; display: flex; justify-content: center; }
  .nav__links ul { position: relative; list-style: none; margin: 0; padding: 4px; display: flex; gap: 2px; border-radius: 999px; }
  .nav__links a {
    position: relative; z-index: 1; display: inline-block; padding: 8px 14px; border-radius: 999px;
    color: var(--muted); font: 500 .88rem var(--font-body); text-decoration: none; white-space: nowrap;
    transition: color .25s var(--ease);
  }
  .nav__links a:hover, .nav__links a.is-active, .nav__links a[aria-current="page"] { color: var(--fg); }
  .nav__pill {
    position: absolute; top: 4px; left: var(--px, 0); width: var(--pw, 0); height: calc(100% - 8px);
    border-radius: 999px; background: var(--surface-2); border: 1px solid var(--border);
    opacity: var(--po, 0);
    transition: left .45s var(--ease), width .45s var(--ease), opacity .3s var(--ease);
  }

  .nav__end { margin-left: auto; display: flex; align-items: center; gap: 6px; }
  .nav__cta {
    display: inline-flex; align-items: center; gap: 7px; padding: 8px 14px; border-radius: 999px;
    background: var(--accent); color: #fff; font: 600 .82rem var(--font-body); text-decoration: none;
    box-shadow: 0 8px 22px -10px rgba(var(--accent-rgb), .9);
    transition: transform .3s var(--ease), box-shadow .3s var(--ease), filter .3s;
  }
  .nav__cta:hover { text-decoration: none; transform: translateY(-1px); filter: brightness(1.08); }
  .nav__icon {
    position: relative; width: 40px; height: 40px; border-radius: 50%; display: inline-grid; place-items: center;
    background: transparent; border: 1px solid var(--border); color: var(--muted); cursor: pointer;
    transition: color .25s, border-color .25s, background .25s;
  }
  .nav__icon:hover { color: var(--fg); border-color: var(--border-strong); background: var(--surface); }
  .nav__sun, .nav__moon { grid-area: 1 / 1; transition: transform .5s var(--ease), opacity .3s; }
  .nav__moon { opacity: 0; transform: rotate(-90deg) scale(.6); }
  :root[data-theme="light"] .nav__sun { opacity: 0; transform: rotate(90deg) scale(.6); }
  :root[data-theme="light"] .nav__moon { opacity: 1; transform: none; }

  .nav__burger { display: none; flex-direction: column; align-items: center; justify-content: center; gap: 4px; }
  .nav__burger span { display: block; width: 17px; height: 1.6px; background: currentColor; border-radius: 2px; transition: transform .35s var(--ease), opacity .3s, width .3s var(--ease); }
  .nav__burger[aria-expanded="true"] span:nth-child(1) { transform: translateY(5.6px) rotate(45deg); }
  .nav__burger[aria-expanded="true"] span:nth-child(2) { opacity: 0; width: 0; }
  .nav__burger[aria-expanded="true"] span:nth-child(3) { transform: translateY(-5.6px) rotate(-45deg); }

  .nav__drawer {
    pointer-events: auto;
    max-width: var(--container); margin: 8px auto 0;
    border-radius: var(--radius-lg); overflow: hidden;
    background: color-mix(in oklab, var(--bg) 84%, transparent);
    border: 1px solid transparent;
    backdrop-filter: blur(22px); -webkit-backdrop-filter: blur(22px);
    max-height: 0; transition: max-height .45s var(--ease), border-color .3s;
  }
  .nav__drawer.is-open { max-height: 420px; border-color: var(--border); }
  .nav__drawer ul { list-style: none; margin: 0; padding: 10px; display: flex; flex-direction: column; }
  .nav__drawer li { opacity: 0; transform: translateY(8px); transition: opacity .4s var(--ease), transform .4s var(--ease); transition-delay: calc(var(--i) * 40ms); }
  .nav__drawer.is-open li { opacity: 1; transform: none; }
  .nav__drawer a { display: block; padding: 12px 14px; border-radius: 12px; color: var(--fg); font: 600 1.05rem var(--font-display); text-decoration: none; }
  .nav__drawer a:hover { background: var(--surface-2); }

  @media (max-width: 900px) { .nav__links a { padding: 8px 10px; font-size: .84rem; } }
  @media (max-width: 760px) {
    .nav__links { display: none; }
    .nav__burger { display: inline-flex; }
    .nav__name { display: none; }
  }
</style>

<script>
  document.getElementById('nav-color')?.addEventListener('click', () => (window as any).__ovOpenThemePicker?.());

  const nav = document.getElementById('nav')!;
  const burger = nav.querySelector<HTMLButtonElement>('.nav__burger')!;
  const drawer = document.getElementById('nav-drawer')!;
  const setOpen = (open: boolean) => {
    drawer.classList.toggle('is-open', open);
    burger.setAttribute('aria-expanded', String(open));
    drawer.setAttribute('aria-hidden', String(!open));
  };
  burger.addEventListener('click', () => setOpen(!drawer.classList.contains('is-open')));
  drawer.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));

  const onScroll = () => nav.classList.toggle('is-scrolled', scrollY > 24);
  addEventListener('scroll', onScroll, { passive: true }); onScroll();

  // Sliding pill follows the active section
  const list = nav.querySelector<HTMLUListElement>('.nav__links ul');
  const anchors = Array.from(nav.querySelectorAll<HTMLAnchorElement>('.nav__links a[data-nav]'));
  const movePill = (a: HTMLAnchorElement | null) => {
    if (!list) return;
    if (!a) { list.style.setProperty('--po', '0'); return; }
    const lr = list.getBoundingClientRect(), ar = a.getBoundingClientRect();
    list.style.setProperty('--px', `${ar.left - lr.left}px`);
    list.style.setProperty('--pw', `${ar.width}px`);
    list.style.setProperty('--po', '1');
  };
  anchors.forEach((a) => a.addEventListener('mouseenter', () => movePill(a)));
  list?.addEventListener('mouseleave', () => movePill(anchors.find((a) => a.classList.contains('is-active')) || null));

  const sections = ['top', ...anchors.map((a) => a.dataset.nav!)].map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];
  if (sections.length) {
    const spy = new IntersectionObserver((entries) => {
      const vis = entries.filter((e) => e.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
      if (!vis) return;
      const id = vis.target.id === 'top' ? '' : vis.target.id;
      anchors.forEach((a) => a.classList.toggle('is-active', a.dataset.nav === id));
      movePill(anchors.find((a) => a.dataset.nav === id) || null);
    }, { rootMargin: '-35% 0px -55% 0px', threshold: [0, 0.2, 0.5] });
    sections.forEach((s) => spy.observe(s));
  } else {
    movePill(anchors.find((a) => a.getAttribute('aria-current') === 'page') || null);
  }
</script>

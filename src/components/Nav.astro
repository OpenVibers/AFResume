---
import profile from "../data/profile.json";
const links = [
  { href: "/#network",    label: "OpenVibe",   id: "network",    icon: "fa-solid fa-diagram-project" },
  { href: "/#work",       label: "Work",       id: "work",       icon: "fa-solid fa-briefcase" },
  { href: "/#experience", label: "Experience", id: "experience", icon: "fa-solid fa-clock-rotate-left" },
  { href: "/#skills",     label: "Skills",     id: "skills",     icon: "fa-solid fa-code" },
  { href: "/resume",      label: "Resume",     id: "resume",     icon: "fa-solid fa-file-lines" },
  { href: "/#contact",    label: "Contact",    id: "contact",    icon: "fa-solid fa-paper-plane" },
];
const path = Astro.url.pathname;
---
<header class="nav" id="nav">
  <div class="nav__inner">
    <a href="/" class="nav__brand" aria-label="Alex Frison, home">
      <span class="nav__mark" id="nav-mark" aria-hidden="true">
        <svg viewBox="0 0 40 40" width="34" height="34">
          <defs><linearGradient id="nmg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="var(--accent)"/><stop offset=".55" stop-color="var(--violet)"/><stop offset="1" stop-color="var(--accent-2)"/></linearGradient></defs>
          <rect x="1" y="1" width="38" height="38" rx="11" fill="none" stroke="url(#nmg)" stroke-width="1.5"/>
          <path d="M8 28 L14 12 L20 28 M10.4 22 h7.2" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M24.5 28 V12 H32.5 M24.5 20 H31" fill="none" stroke="url(#nmg)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          <!-- A short bright arc travels the frame's perimeter continuously — the same "comet
               border" trick OpenVibe's own brand mark uses (packages/openvibe-shared/ov-mark.js) —
               so the mark reads as alive even before anyone touches it. -->
          <rect class="nav__mark-comet" x="1" y="1" width="38" height="38" rx="11" fill="none" stroke="#fff" stroke-width="1.5" stroke-linecap="round" pathLength="100" stroke-dasharray="6 94"/>
        </svg>
        <span class="nav__mark-pulse" aria-hidden="true"></span>
      </span>
      <span class="nav__name">Alex Frison</span>
    </a>

    <nav class="nav__links" aria-label="Primary">
      <ul>
        {links.map((l) => (
          <li><a href={l.href} data-nav={l.id} aria-current={path.startsWith(`/${l.id}`) ? "page" : undefined}><i class={l.icon} aria-hidden="true"></i> {l.label}</a></li>
        ))}
        <li class="nav__pill" aria-hidden="true"></li>
      </ul>
    </nav>

    <div class="nav__end">
      <a class="nav__cta" href={profile.resumePdf} data-resume-link aria-label="Download resume PDF"><i class="fa-solid fa-arrow-down"></i><span>PDF</span></a>
      <button class="nav__icon" id="nav-color" aria-label="Pick an accent color, and dark or light theme">
        <i class="fa-solid fa-palette"></i>
        <span class="nav__color-dot" id="nav-color-dot" aria-hidden="true"></span>
      </button>
      <button class="nav__icon" data-theme-toggle aria-label="Toggle light and dark theme">
        <i class="fa-solid fa-sun nav__sun"></i><i class="fa-solid fa-moon nav__moon"></i>
      </button>
      <button class="nav__icon nav__burger" aria-label="Open navigation" aria-expanded="false" aria-controls="nav-drawer">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <div class="nav__drawer" id="nav-drawer" aria-hidden="true">
    <ul>
      {links.map((l, i) => (
        <li style={`--i:${i}`}>
          <a href={l.href} class="nav__drawer-link" aria-current={path.startsWith(`/${l.id}`) ? "page" : undefined}>
            <span class="nav__drawer-ico"><i class={l.icon} aria-hidden="true"></i></span>
            <span class="nav__drawer-text">{l.label}</span>
            <i class="fa-solid fa-chevron-right nav__drawer-go" aria-hidden="true"></i>
          </a>
        </li>
      ))}
      <li class="nav__drawer-sep" style={`--i:${links.length}`} aria-hidden="true"></li>
      <li style={`--i:${links.length + 1}`}>
        <a href={profile.resumePdf} data-resume-link class="nav__drawer-link nav__drawer-link--cta">
          <span class="nav__drawer-ico nav__drawer-ico--cta"><i class="fa-solid fa-file-pdf" aria-hidden="true"></i></span>
          <span class="nav__drawer-text">Download resume PDF</span>
          <i class="fa-solid fa-arrow-down nav__drawer-go" aria-hidden="true"></i>
        </a>
      </li>
      <li style={`--i:${links.length + 2}`}>
        <button type="button" class="nav__drawer-link" data-theme-toggle>
          <span class="nav__drawer-ico"><i class="fa-solid fa-circle-half-stroke" aria-hidden="true"></i></span>
          <span class="nav__drawer-text">Light / dark theme</span>
          <i class="fa-solid fa-chevron-right nav__drawer-go" aria-hidden="true"></i>
        </button>
      </li>
    </ul>
  </div>
</header>

<style>
  .nav { position: fixed; top: 0; left: 0; right: 0; z-index: 100; padding: 12px var(--gutter) 0; pointer-events: none; }
  .nav__inner {
    pointer-events: auto;
    max-width: var(--container); margin: 0 auto;
    display: flex; align-items: center; gap: 14px;
    height: 58px; padding: 0 10px 0 12px;
    border-radius: 999px;
    border: 1px solid transparent;
    transition: background .45s var(--ease), border-color .45s var(--ease), box-shadow .45s var(--ease), backdrop-filter .45s;
  }
  .nav.is-scrolled .nav__inner {
    background: color-mix(in oklab, var(--bg) 62%, transparent);
    border-color: var(--border);
    backdrop-filter: blur(22px) saturate(160%);
    -webkit-backdrop-filter: blur(22px) saturate(160%);
    box-shadow: 0 10px 40px -18px rgba(0,0,0,.6), inset 0 1px 0 rgba(255,255,255,.05);
  }
  .nav__brand { display: inline-flex; align-items: center; gap: 10px; color: var(--fg); font-family: var(--font-display); font-weight: 700; letter-spacing: -.01em; text-decoration: none; flex: none; }
  .nav__brand:hover { text-decoration: none; }
  .nav__mark { position: relative; display: inline-grid; place-items: center; color: var(--fg); transition: transform .5s var(--ease); }
  .nav__brand:hover .nav__mark { transform: rotate(-8deg) scale(1.08); }
  .nav__mark-comet { opacity: .85; animation: navMarkComet 5s linear infinite; transition: animation-duration .3s; }
  .nav__brand:hover .nav__mark-comet { animation-duration: 1.1s; }
  @keyframes navMarkComet { to { stroke-dashoffset: -100; } }
  .nav__mark-pulse {
    position: absolute; inset: -6px; border-radius: 14px; pointer-events: none;
    box-shadow: 0 0 0 0 rgba(var(--accent-rgb), 0);
  }
  .nav__mark-pulse.is-pulsing { animation: navMarkPulse 900ms var(--ease); }
  @keyframes navMarkPulse {
    0% { box-shadow: 0 0 0 0 rgba(var(--accent-rgb), .55); }
    70% { box-shadow: 0 0 0 10px rgba(var(--accent-rgb), 0); }
    100% { box-shadow: 0 0 0 0 rgba(var(--accent-rgb), 0); }
  }
  @media (prefers-reduced-motion: reduce) { .nav__mark-comet { animation: none; } }
  .nav__name { font-size: .98rem; }

  .nav__links { flex: 1; display: flex; justify-content: center; }
  .nav__links ul { position: relative; list-style: none; margin: 0; padding: 4px; display: flex; gap: 2px; border-radius: 999px; }
  .nav__links a {
    position: relative; z-index: 1; display: inline-flex; align-items: center; gap: 7px; padding: 8px 14px; border-radius: 999px;
    color: var(--muted); font: 500 .88rem var(--font-body); text-decoration: none; white-space: nowrap;
    transition: color .25s var(--ease);
  }
  .nav__links a i { font-size: .78em; opacity: .75; transition: opacity .25s, color .25s; }
  .nav__links a:hover, .nav__links a.is-active, .nav__links a[aria-current="page"] { color: var(--fg); }
  .nav__links a:hover i, .nav__links a.is-active i, .nav__links a[aria-current="page"] i { opacity: 1; color: var(--accent); }
  .nav__pill {
    position: absolute; top: 4px; left: var(--px, 0); width: var(--pw, 0); height: calc(100% - 8px);
    border-radius: 999px; background: var(--surface-2); border: 1px solid var(--border);
    opacity: var(--po, 0);
    transition: left .45s var(--ease), width .45s var(--ease), opacity .3s var(--ease);
  }

  .nav__end { margin-left: auto; display: flex; align-items: center; gap: 6px; }
  .nav__cta {
    display: inline-flex; align-items: center; gap: 7px; padding: 8px 14px; border-radius: 999px;
    background: var(--accent); color: #fff; font: 600 .82rem var(--font-body); text-decoration: none;
    box-shadow: 0 8px 22px -10px rgba(var(--accent-rgb), .9);
    transition: transform .3s var(--ease), box-shadow .3s var(--ease), filter .3s;
  }
  .nav__cta:hover { text-decoration: none; transform: translateY(-1px); filter: brightness(1.08); }
  .nav__icon {
    position: relative; width: 40px; height: 40px; border-radius: 50%; display: inline-grid; place-items: center;
    background: transparent; border: 1px solid var(--border); color: var(--muted); cursor: pointer;
    transition: color .25s, border-color .25s, background .25s;
  }
  .nav__icon:hover { color: var(--fg); border-color: var(--border-strong); background: var(--surface); }
  .nav__color-dot {
    position: absolute; right: 6px; bottom: 6px; width: 9px; height: 9px; border-radius: 50%;
    background: var(--accent); border: 1.5px solid var(--surface-solid); box-shadow: 0 0 0 1px rgba(var(--accent-rgb), .4);
    pointer-events: none;
  }
  .nav__sun, .nav__moon { grid-area: 1 / 1; transition: transform .5s var(--ease), opacity .3s; }
  .nav__moon { opacity: 0; transform: rotate(-90deg) scale(.6); }
  :root[data-theme="light"] .nav__sun { opacity: 0; transform: rotate(90deg) scale(.6); }
  :root[data-theme="light"] .nav__moon { opacity: 1; transform: none; }

  .nav__burger { display: none; flex-direction: column; align-items: center; justify-content: center; gap: 4px; }
  .nav__burger span { display: block; width: 17px; height: 1.6px; background: currentColor; border-radius: 2px; transition: transform .35s var(--ease), opacity .3s, width .3s var(--ease); }
  .nav__burger[aria-expanded="true"] span:nth-child(1) { transform: translateY(5.6px) rotate(45deg); }
  .nav__burger[aria-expanded="true"] span:nth-child(2) { opacity: 0; width: 0; }
  .nav__burger[aria-expanded="true"] span:nth-child(3) { transform: translateY(-5.6px) rotate(-45deg); }

  .nav__drawer {
    pointer-events: auto;
    max-width: var(--container); margin: 8px auto 0;
    border-radius: var(--radius-lg); overflow: hidden;
    background: color-mix(in oklab, var(--bg) 84%, transparent);
    border: 1px solid transparent;
    backdrop-filter: blur(22px); -webkit-backdrop-filter: blur(22px);
    max-height: 0; transition: max-height .45s var(--ease), border-color .3s;
  }
  .nav__drawer.is-open { max-height: 620px; border-color: var(--border); }
  .nav__drawer ul { list-style: none; margin: 0; padding: 10px; display: flex; flex-direction: column; gap: 3px; }
  .nav__drawer li { opacity: 0; transform: translateY(8px); transition: opacity .4s var(--ease), transform .4s var(--ease); transition-delay: calc(var(--i) * 40ms); }
  .nav__drawer.is-open li { opacity: 1; transform: none; }
  .nav__drawer-sep { height: 1px; margin: 6px 10px; background: var(--border); flex: none; }

  .nav__drawer-link {
    display: flex; align-items: center; gap: 13px; width: 100%; padding: 10px 12px; border-radius: 14px;
    color: var(--fg); font: 600 1rem var(--font-display); text-decoration: none;
    background: transparent; border: 1px solid transparent; cursor: pointer; text-align: left;
    transition: background .2s var(--ease), border-color .2s var(--ease), transform .2s var(--ease);
  }
  .nav__drawer-link:hover, .nav__drawer-link:active { background: var(--surface-2); border-color: var(--border); text-decoration: none; transform: translateX(2px); }
  .nav__drawer-link[aria-current="page"] { background: var(--surface); border-color: var(--border-strong); }
  .nav__drawer-ico {
    flex: none; width: 38px; height: 38px; border-radius: 11px; display: inline-grid; place-items: center;
    background: rgba(var(--accent-rgb), .12); color: var(--accent); font-size: .95rem;
    border: 1px solid rgba(var(--accent-rgb), .2);
  }
  .nav__drawer-text { flex: 1; min-width: 0; }
  .nav__drawer-go { flex: none; font-size: .72rem; color: var(--dim); opacity: 0; transform: translateX(-3px); transition: opacity .2s var(--ease), transform .2s var(--ease); }
  .nav__drawer-link:hover .nav__drawer-go { opacity: 1; transform: none; }

  .nav__drawer-link--cta { background: var(--grad); color: #fff; }
  .nav__drawer-link--cta:hover { background: var(--grad); filter: brightness(1.08); transform: translateX(2px); }
  .nav__drawer-ico--cta { background: rgba(255,255,255,.2); color: #fff; border-color: rgba(255,255,255,.3); }
  .nav__drawer-link--cta .nav__drawer-go { color: #fff; opacity: .8; }

  @media (max-width: 900px) { .nav__links a { padding: 8px 10px; font-size: .84rem; } }
  @media (max-width: 760px) {
    .nav__links { display: none; }
    .nav__burger { display: inline-flex; }
    .nav__name { display: none; }
  }
</style>

<script>
  document.getElementById('nav-color')?.addEventListener('click', () => (window as any).__ovOpenThemePicker?.());

  const nav = document.getElementById('nav')!;
  const burger = nav.querySelector<HTMLButtonElement>('.nav__burger')!;
  const drawer = document.getElementById('nav-drawer')!;
  const setOpen = (open: boolean) => {
    drawer.classList.toggle('is-open', open);
    burger.setAttribute('aria-expanded', String(open));
    drawer.setAttribute('aria-hidden', String(!open));
  };
  burger.addEventListener('click', () => setOpen(!drawer.classList.contains('is-open')));
  drawer.querySelectorAll('a, button').forEach((el) => el.addEventListener('click', () => setOpen(false)));

  // Any open panel — this drawer or another site dropdown that opts in with data-dismiss-outside
  // — closes when a click lands outside both its trigger and its own box, so nothing lingers
  // open while someone interacts with the rest of the page.
  document.addEventListener('click', (e) => {
    const t = e.target as Node;
    if (drawer.classList.contains('is-open') && !drawer.contains(t) && !burger.contains(t)) setOpen(false);
  }, { capture: true });

  const onScroll = () => nav.classList.toggle('is-scrolled', scrollY > 24);
  addEventListener('scroll', onScroll, { passive: true }); onScroll();

  // A little dot on the palette icon confirms the chosen accent took, without opening anything.
  const dot = document.getElementById('nav-color-dot');
  const syncDot = () => { if (dot) dot.style.background = getComputedStyle(document.documentElement).getPropertyValue('--accent').trim(); };
  syncDot();
  new MutationObserver(syncDot).observe(document.documentElement, { attributes: true, attributeFilter: ['style'] });

  // Sliding pill follows the active section
  const list = nav.querySelector<HTMLUListElement>('.nav__links ul');
  const anchors = Array.from(nav.querySelectorAll<HTMLAnchorElement>('.nav__links a[data-nav]'));
  const movePill = (a: HTMLAnchorElement | null) => {
    if (!list) return;
    if (!a) { list.style.setProperty('--po', '0'); return; }
    const lr = list.getBoundingClientRect(), ar = a.getBoundingClientRect();
    list.style.setProperty('--px', `${ar.left - lr.left}px`);
    list.style.setProperty('--pw', `${ar.width}px`);
    list.style.setProperty('--po', '1');
  };
  anchors.forEach((a) => a.addEventListener('mouseenter', () => movePill(a)));
  list?.addEventListener('mouseleave', () => movePill(anchors.find((a) => a.classList.contains('is-active')) || null));

  const sections = ['top', ...anchors.map((a) => a.dataset.nav!)].map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];
  if (sections.length) {
    let lastSection = '';
    const markPulse = document.querySelector('#nav-mark .nav__mark-pulse');
    const spy = new IntersectionObserver((entries) => {
      const vis = entries.filter((e) => e.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
      if (!vis) return;
      const id = vis.target.id === 'top' ? '' : vis.target.id;
      anchors.forEach((a) => a.classList.toggle('is-active', a.dataset.nav === id));
      movePill(anchors.find((a) => a.dataset.nav === id) || null);
      // The brand mark gives a quiet pulse each time you cross into a new section — a small
      // sign the page is tracking where you are, not just a static logo.
      if (id !== lastSection && markPulse) {
        lastSection = id;
        markPulse.classList.remove('is-pulsing');
        void (markPulse as HTMLElement).offsetWidth; // restart the animation
        markPulse.classList.add('is-pulsing');
      }
    }, { rootMargin: '-35% 0px -55% 0px', threshold: [0, 0.2, 0.5] });
    sections.forEach((s) => spy.observe(s));
  } else {
    movePill(anchors.find((a) => a.getAttribute('aria-current') === 'page') || null);
  }
</script>

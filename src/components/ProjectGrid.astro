---
import { getCollection } from "astro:content";
interface Props { limit?: number; showHead?: boolean; id?: string; }
const { limit, showHead = true, id = "work" } = Astro.props;
const all = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const projects = limit ? all.filter((p) => p.data.featured).slice(0, limit) : all;
const catLabel: Record<string, string> = {
  openvibe: "OpenVibe", powerchat: "PowerChat", amazon: "Amazon", ai: "AI", infra: "Infra & ops",
  game: "Games", tools: "Tools", python: "Python", hardware: "Hardware", web: "Web",
};
const cats = Array.from(new Set(projects.map((p) => p.data.category)));
---
<section class={`section work`} id={id} aria-labelledby={`${id}-title`}>
  <div class="container">
    {showHead && (
      <div class="sec-head">
        <span class="sec-num" aria-hidden="true">03</span>
        <div>
          <div class="sec-index">Selected work</div>
          <h2 class="sec-title" id={`${id}-title`}>Things I <em>shipped</em>, not slides about them.</h2>
        </div>
        <p class="sec-lead">Platform programs at PowerChat, the OpenVibe services, the AI and analytics tooling I built at Amazon, and a few side projects that kept the tools sharp.</p>
      </div>
    )}

    <div class="filters" role="tablist" aria-label="Filter projects" data-reveal>
      <button class="filter is-active" data-filter="all" role="tab" aria-selected="true">All <span class="filter__n">{projects.length}</span></button>
      {cats.map((c) => (
        <button class="filter" data-filter={c} role="tab" aria-selected="false">{catLabel[c] ?? c} <span class="filter__n">{projects.filter((p) => p.data.category === c).length}</span></button>
      ))}
    </div>

    <ul class={`pgrid ${limit ? "pgrid--fades" : ""}`} data-stagger>
      {projects.map((p) => (
        <li class={`pcard spot cat-${p.data.category} ${p.data.image ? "has-img" : ""}`} data-cat={p.data.category} data-tilt>
          <a href={`/portfolio/${p.slug}`} class="pcard__link" aria-label={`${p.data.title}: ${p.data.summary}`}></a>
          {p.data.image ? (
            <div class="pcard__img" aria-hidden="true"><img src={p.data.image} alt="" loading="lazy" width="800" height="500" /></div>
          ) : (
            <div class="pcard__deco" aria-hidden="true"><i class={p.data.icon ?? "fa-solid fa-cube"}></i><span class="pcard__deco-grid"></span></div>
          )}
          <div class="pcard__body">
            <div class="pcard__top">
              <span class="pcard__icon"><i class={p.data.icon ?? "fa-solid fa-cube"}></i></span>
              <span class="pcard__cat">{catLabel[p.data.category] ?? p.data.category}</span>
              {p.data.year && <span class="pcard__year mono">{p.data.year}</span>}
            </div>
            <h3 class="pcard__title">{p.data.title}</h3>
            <p class="pcard__sum">{p.data.summary}</p>
            <ul class="pcard__tech">
              {p.data.tech.slice(0, 4).map((t) => <li>{t}</li>)}
              {p.data.tech.length > 4 && <li class="more">+{p.data.tech.length - 4}</li>}
            </ul>
            <div class="pcard__foot">
              <span class="pcard__more">Case notes <span class="btn__arrow">→</span></span>
              {p.data.links?.live && <a class="pcard__ext" href={p.data.links.live} target="_blank" rel="noopener" aria-label={`Open ${p.data.title} live`}><i class="fa-solid fa-arrow-up-right-from-square"></i></a>}
            </div>
          </div>
        </li>
      ))}
    </ul>

  </div>
</section>

<style>
  .filters { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 26px; }
  .filter {
    display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px; border-radius: 999px;
    background: transparent; border: 1px solid var(--border); color: var(--muted); cursor: pointer;
    font: 500 .84rem var(--font-body); transition: all .3s var(--ease);
  }
  .filter:hover { color: var(--fg); border-color: var(--border-strong); }
  .filter.is-active { background: var(--fg); color: var(--bg); border-color: var(--fg); }
  .filter__n { font-family: var(--font-mono); font-size: .7rem; opacity: .7; }

  .pgrid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  /* The last row visually trails off into the page rather than ending on a hard edge right
     above the "see all" button — a real fade of the content itself, not a separate overlay
     sitting in the empty gap below it. */
  .pgrid--fades {
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 80%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 0%, #000 80%, transparent 100%);
  }
  .pcard {
    position: relative; overflow: hidden; display: flex; flex-direction: column;
    border-radius: var(--radius-lg); background: var(--surface); border: 1px solid var(--border);
    transition: transform .5s var(--ease), border-color .35s var(--ease), box-shadow .5s var(--ease), opacity .4s var(--ease);
    will-change: transform;
  }
  .pcard:hover { border-color: rgba(var(--accent-rgb), .4); box-shadow: var(--shadow-card), var(--shadow-glow); }
  .pcard.is-hidden { display: none; }
  .pcard__link { position: absolute; inset: 0; z-index: 2; border-radius: inherit; }
  .pcard__img { aspect-ratio: 16 / 9; overflow: hidden; border-bottom: 1px solid var(--border); background: var(--bg-2); }
  .pcard__img img { width: 100%; height: 100%; object-fit: cover; object-position: top; transition: transform 1s var(--ease); }
  .pcard:hover .pcard__img img { transform: scale(1.05); }
  .pcard__deco { position: relative; aspect-ratio: 16 / 9; overflow: hidden; border-bottom: 1px solid var(--border); background: var(--grad-soft); display: grid; place-items: center; }
  .pcard__deco i { font-size: 3.4rem; color: var(--fg); opacity: .22; transition: transform .8s var(--ease), opacity .5s; }
  .pcard:hover .pcard__deco i { transform: scale(1.12) rotate(-6deg); opacity: .4; }
  .pcard__deco-grid { position: absolute; inset: 0; background-image: linear-gradient(to right, rgba(255,255,255,.05) 1px, transparent 1px), linear-gradient(to bottom, rgba(255,255,255,.05) 1px, transparent 1px); background-size: 28px 28px; mask-image: radial-gradient(60% 60% at 50% 50%, #000, transparent); -webkit-mask-image: radial-gradient(60% 60% at 50% 50%, #000, transparent); }
  .cat-powerchat .pcard__deco { background: linear-gradient(135deg, rgba(var(--accent-2-rgb), .22), rgba(139,92,246,.14)); }
  .cat-ai .pcard__deco, .cat-amazon .pcard__deco { background: linear-gradient(135deg, rgba(var(--accent-3-rgb), .18), rgba(var(--accent-rgb), .14)); }
  .pcard__body { position: relative; z-index: 1; padding: 20px 20px 18px; display: flex; flex-direction: column; gap: 10px; flex: 1; }
  .pcard__top { display: flex; align-items: center; gap: 10px; }
  .pcard__icon { width: 34px; height: 34px; border-radius: 10px; display: inline-grid; place-items: center; background: rgba(var(--accent-rgb), .12); color: var(--accent); border: 1px solid rgba(var(--accent-rgb), .18); font-size: .85rem; }
  .cat-powerchat .pcard__icon { background: rgba(var(--accent-2-rgb), .12); color: var(--accent-2); border-color: rgba(var(--accent-2-rgb), .22); }
  .cat-amazon .pcard__icon, .cat-ai .pcard__icon { background: rgba(var(--accent-3-rgb), .12); color: var(--accent-3); border-color: rgba(var(--accent-3-rgb), .22); }
  .cat-infra .pcard__icon { background: rgba(139, 92, 246, .14); color: var(--violet); border-color: rgba(139, 92, 246, .25); }
  .pcard__cat { font-family: var(--font-mono); font-size: .7rem; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); }
  .pcard__year { margin-left: auto; font-size: .7rem; color: var(--dim); }
  .pcard__title { margin: 0; font-size: 1.15rem; }
  .pcard__sum { margin: 0; font-size: .9rem; color: var(--muted); line-height: 1.55; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .pcard__tech { list-style: none; margin: auto 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .pcard__tech li { font: 500 .68rem var(--font-mono); padding: 3px 8px; border-radius: 6px; background: var(--surface-2); color: var(--muted); border: 1px solid var(--border); }
  .pcard__tech .more { color: var(--dim); }
  .pcard__foot { display: flex; align-items: center; justify-content: space-between; padding-top: 6px; }
  .pcard__more { font: 600 .78rem var(--font-mono); color: var(--accent); }
  .pcard__ext { position: relative; z-index: 3; width: 32px; height: 32px; border-radius: 50%; display: inline-grid; place-items: center; color: var(--muted); border: 1px solid var(--border); transition: all .25s; }
  .pcard__ext:hover { color: var(--fg); border-color: var(--accent); text-decoration: none; background: rgba(var(--accent-rgb), .12); }
  @media (max-width: 1000px) { .pgrid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .pgrid { grid-template-columns: 1fr; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.work').forEach((sec) => {
    const btns = sec.querySelectorAll<HTMLButtonElement>('.filter');
    const cards = sec.querySelectorAll<HTMLElement>('.pcard');
    // `f` may be a comma list (the home page's group links pass e.g. "ai,amazon"); a chip is
    // active only when it matches exactly.
    const apply = (f: string) => {
      const set = new Set(f.split(',').map((s) => s.trim()).filter(Boolean));
      btns.forEach((x) => { const on = x.dataset.filter === f; x.classList.toggle('is-active', on); x.setAttribute('aria-selected', String(on)); });
      let shown = 0;
      cards.forEach((c) => {
        const show = set.has('all') || set.has(c.dataset.cat || '');
        if (show) {
          c.classList.remove('is-hidden');
          c.animate([{ opacity: 0, transform: 'translateY(14px) scale(.98)' }, { opacity: 1, transform: 'none' }], { duration: 450, delay: shown++ * 40, easing: 'cubic-bezier(.22,1,.36,1)', fill: 'backwards' });
        } else c.classList.add('is-hidden');
      });
    };
    btns.forEach((b) => b.addEventListener('click', () => { apply(b.dataset.filter!); history.replaceState(null, '', b.dataset.filter === 'all' ? location.pathname : `?cat=${b.dataset.filter}`); }));
    const initial = new URLSearchParams(location.search).get('cat');
    if (initial) apply(initial);
  });
</script>

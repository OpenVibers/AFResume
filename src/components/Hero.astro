---
import profile from "../data/profile.json";
const name = "Alex Frison";
const words = name.split(" ");
const offsets = words.map((_, i) => words.slice(0, i).join(" ").length + (i ? 1 : 0));
import fcAlbum from "../data/fc-album.json";
---
<section class="hero" id="top" aria-labelledby="hero-title">
  <canvas class="hero__aurora" id="aurora" aria-hidden="true"></canvas>
  <div class="hero__veil" aria-hidden="true"></div>

  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="hero__status hero__in" style="--d:0ms">
        <span class="hero__status-seg hero__status-seg--now"><span class="live-dot" aria-hidden="true"></span>Now</span>
        <span class="hero__status-seg">contract engineer at <a href="https://powerchat.live" target="_blank" rel="noopener">PowerChat</a></span>
        <span class="hero__status-seg">building <a href="#network">OpenVibe</a></span>
      </p>

      <h1 class="hero__title" id="hero-title" aria-label={name}>
        {words.map((w, wi) => (
          <span class="hero__word" aria-hidden="true">
            {Array.from(w).map((c, ci) => {
              const i = offsets[wi] + ci;
              const last = wi === words.length - 1 && ci === w.length - 1;
              return <span class={`hero__ch ${last ? "hero__ch--last" : ""}`} style={`--i:${i}`}>{c}</span>;
            })}
          </span>
        ))}
      </h1>

      <p class="hero__role" aria-live="polite">
        <span class="hero__role-static" id="rotator-article">I'm a</span>
        <span class="hero__rotator" id="rotator" data-roles={JSON.stringify(profile.roles)}>{profile.roles[0]}</span>
      </p>

      <div class="hero__lead hero__in" style="--d:650ms">
        <p>{profile.headline} That includes AI agents and automation that run in production around the clock and do the work of a whole team. I've been building software since I was a kid, and Amazon showed me how real systems break at scale: first keeping an automated robotics floor running, then as an ICQA data analyst tracking down inventory discrepancies for SOX compliance.</p>
        <p>Bring me a rough idea and I'll turn it into a working product.</p>
        <p>I built and run the <strong><a href="https://openvibe.network" target="_blank" rel="noopener">OpenVibe network</a></strong> on my own, and right now I'm rebuilding <strong><a href="https://powerchat.live" target="_blank" rel="noopener">PowerChat</a></strong>'s developer platform and payments.</p>
      </div>

      <div class="hero__cta hero__in" style="--d:800ms">
        <a href="#work" class="btn btn--primary" data-magnetic><i class="fa-solid fa-layer-group"></i> See what I've built <span class="btn__arrow">→</span></a>
        <a href={profile.resumePdf} class="btn" data-magnetic data-resume-link><i class="fa-solid fa-file-pdf"></i> Resume PDF</a>
        <a href="#contact" class="btn btn--ghost" data-magnetic><i class="fa-solid fa-paper-plane"></i> Get in touch</a>
        <!-- Only on the FC album visit (?pae2, from the hat): jump straight to the music. -->
        <a href="#album" class="btn hero__album" data-magnetic aria-label={`Jump to ${fcAlbum.title}, ${fcAlbum.tracks.length} songs`}>
          <span class="hero__eq" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
          <span class="hero__album-label">
            <span class="hero__album-name">{fcAlbum.title}</span>
            <span class="hero__album-badge" aria-hidden="true">{fcAlbum.tracks.length} songs</span>
          </span>
          <span class="btn__arrow hero__album-arrow" aria-hidden="true">↓</span>
        </a>
      </div>

      <div class="hero__tags hero__in" style="--d:950ms">
        <div class="hero__tags-label"><i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i> What I build and do</div>
        <ul class="hero__tags-grid" aria-label="Areas of work">
          {profile.strengths.map((t, i) => (
            <li class="hero__tag" style={`--i:${i}`}><span class="hero__tag-ico"><i class={t.icon} aria-hidden="true"></i></span><span>{t.label}</span></li>
          ))}
        </ul>
      </div>
    </div>

    <div class="hero__visual hero__in hero__in--scale" style="--d:300ms">
      <div class="portrait" data-tilt id="portrait">
        <div class="portrait__halo" aria-hidden="true"></div>
        <div class="portrait__ring portrait__ring--a" aria-hidden="true"></div>
        <div class="portrait__ring portrait__ring--b" aria-hidden="true"></div>
        <div class="portrait__orbit" aria-hidden="true"><span></span></div>
        <div class="portrait__plinth" aria-hidden="true"><span class="portrait__grid"></span><span class="portrait__glint"></span><span class="portrait__scan"></span></div>
        <canvas class="portrait__fx" id="portrait-fx" aria-hidden="true"></canvas>
        <div class="portrait__shots">
          <img src="/assets/img/me-cut1.png" alt="Portrait of Alex Frison" class="portrait__img is-on" id="portrait-a" width="889" height="1177" fetchpriority="high" />
          <img src="/assets/img/me-cut2.png" alt="" class="portrait__img" id="portrait-b" width="829" height="1074" loading="lazy" />
        </div>
        <div class="portrait__tag portrait__tag--tl" aria-hidden="true"><i class="fa-solid fa-location-dot"></i> <span class="portrait__tag-l">{profile.locationShort}</span><span class="portrait__tag-s">{profile.locationShort.split(" / ")[0]}, {profile.locationShort.split(", ").pop()}</span></div>
        <div class="portrait__tag portrait__tag--br" aria-hidden="true"><span class="live-dot"></span> Open to just about anything</div>
      </div>
    </div>
  </div>

  <a href="#metrics" class="hero__scroll" aria-label="Scroll to content">
    <span class="hero__mouse"><span></span></span>
    <span class="hero__scroll-txt">scroll</span>
  </a>
</section>

<style>
  .hero {
    position: relative; isolation: isolate; overflow: clip;
    min-height: 100svh;
    padding: calc(var(--nav-h) + clamp(40px, 8vh, 90px)) 0 clamp(60px, 8vh, 100px);
    display: flex; align-items: center;
  }
  .hero__aurora { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -2; filter: blur(52px) saturate(115%); opacity: .62; transform: scale(1.15); }
  :root[data-theme="light"] .hero__aurora { opacity: .45; }
  .hero__veil { position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgba(7,9,15,.35) 0%, transparent 30%, transparent 55%, var(--bg) 100%), radial-gradient(60% 50% at 30% 45%, rgba(7,9,15,.35), transparent 70%); }
  :root[data-theme="light"] .hero__veil { background: linear-gradient(180deg, transparent 55%, var(--bg) 100%); }

  /* Entrances fill backwards: hidden during their delay, then the element's own (visible) style. A
     forwards fill kept every animated element on its own GPU layer for good, and phones dropped some
     of those layers' paint (blank square tiles where the first row of tags should be). */
  .hero__in { animation: heroIn .9s var(--ease) backwards; animation-delay: var(--d, 0ms); }
  .hero__in--scale { animation-name: heroInScale; }
  @keyframes heroIn { from { opacity: 0; transform: translateY(22px); } to { opacity: 1; transform: none; } }
  @keyframes heroInScale { from { opacity: 0; transform: scale(.94); } to { opacity: 1; transform: none; } }
  .hero__grid { display: grid; grid-template-columns: 1.25fr .9fr; gap: clamp(28px, 5vw, 72px); align-items: center; width: 100%; }
  .hero__copy { min-width: 0; }

  .hero__status {
    display: inline-flex; flex-wrap: wrap; align-items: center; gap: 6px; margin: 0 0 22px;
    padding: 0; font-family: var(--font-mono); font-size: .76rem; color: var(--muted); letter-spacing: .01em;
  }
  .hero__status-seg {
    display: inline-flex; align-items: center; gap: 9px; padding: 7px 13px; border-radius: 999px;
    background: var(--surface); border: 1px solid var(--border); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    white-space: nowrap; line-height: 1.2;
  }
  .hero__status-seg--now { color: var(--fg); font-weight: 600; letter-spacing: .08em; text-transform: uppercase; font-size: .68rem; border-color: rgba(var(--accent-3-rgb), .4); }
  .hero__status a { color: var(--fg); }

  .hero__title {
    margin: 0 0 .2em; font-size: clamp(3rem, 8.6vw, 6.9rem); line-height: .95; letter-spacing: -.04em;
    display: flex; flex-wrap: wrap; column-gap: .22em;
  }
  .hero__word { display: inline-flex; white-space: nowrap; }
  .hero__ch {
    display: inline-block;
    animation: chIn .9s var(--ease) backwards;
    animation-delay: calc(var(--i) * 45ms + 120ms);
    transition: color .3s;
  }
  .hero__ch:hover { color: var(--accent); }
  .hero__ch--last::after { content: "."; display: inline-block; color: transparent; background: var(--grad); -webkit-background-clip: text; background-clip: text; opacity: 0; animation: dotIn .8s var(--ease) forwards 1s; }
  @keyframes chIn { from { opacity: 0; transform: translateY(.6em) rotate(6deg) scale(.9); filter: blur(6px); } to { opacity: 1; transform: none; filter: blur(0); } }
  @keyframes dotIn { 0% { opacity: 0; transform: scale(0) translateY(.2em); } 60% { transform: scale(1.3); } 100% { opacity: 1; transform: none; } }

  .hero__role {
    display: flex; align-items: baseline; align-content: flex-start; gap: .45em; flex-wrap: wrap;
    margin: 0 0 1.2rem; font-family: var(--font-display); font-weight: 700; line-height: 1.25;
    font-size: clamp(1.35rem, 3.4vw, 2.2rem); letter-spacing: -.02em; color: var(--fg);
    /* Reserved for two lines up front: the longest role in the rotation ("Idea-to-Business
       Builder") can wrap on narrow widths, and without this the whole hero — lead text, CTAs,
       chips, everything below — used to jump down for as long as that role was showing. */
    min-height: 2.5em;
  }
  .hero__role-static { color: var(--dim); font-weight: 500; }
  .hero__rotator {
    position: relative; color: var(--accent); padding-bottom: .14em;
    text-shadow: 0 0 22px rgba(var(--accent-rgb), .35);
  }
  /* The rule under the word is a slow-moving gradient sheen; the caret is a thin glowing bar
     that sits inline after the last glyph (not an underscore fighting the rule for the same
     baseline). While the scramble runs the caret goes solid, like a terminal mid-output. */
  .hero__rotator::before {
    content: ""; position: absolute; left: 0; bottom: 0; height: 2px; width: 100%; border-radius: 2px;
    background: linear-gradient(90deg, var(--accent), var(--violet), var(--accent-2), var(--accent-3), var(--accent));
    background-size: 300% 100%; opacity: .6; animation: ruleSheen 6s linear infinite;
    mask-image: linear-gradient(90deg, #000 85%, transparent); -webkit-mask-image: linear-gradient(90deg, #000 85%, transparent);
  }
  @keyframes ruleSheen { to { background-position: -300% 0; } }
  .hero__rotator::after {
    content: ""; display: inline-block; width: .085em; height: .82em; margin-left: .14em; vertical-align: -.04em; border-radius: 2px;
    background: linear-gradient(180deg, var(--accent-2), var(--accent)); box-shadow: 0 0 14px rgba(var(--accent-2-rgb), .8);
    animation: caret 1.15s ease-in-out infinite;
  }
  .hero__rotator.is-scrambling::after { animation: none; opacity: 1; }
  .hero__rotator.is-scrambling { animation: glitchShift .18s steps(2) infinite; }
  @keyframes caret { 0%, 100% { opacity: 1; } 50% { opacity: .15; } }
  @keyframes glitchShift { 0% { text-shadow: -1px 0 rgba(0, 220, 255, .55), 1px 0 rgba(255, 60, 120, .55), 0 0 22px rgba(var(--accent-rgb), .35); } 100% { text-shadow: 1px 0 rgba(0, 220, 255, .55), -1px 0 rgba(255, 60, 120, .55), 0 0 22px rgba(var(--accent-rgb), .35); } }

  .hero__lead { max-width: 58ch; font-size: clamp(1rem, 1.3vw, 1.12rem); color: var(--muted); }
  .hero__lead p { margin: 0; }
  .hero__lead p + p { margin-top: .85em; }
  .hero__cta { display: flex; gap: 12px; flex-wrap: wrap; margin: 1.6rem 0 1.4rem; }

  /* The FC album jump (html.pae2 only): a spinning accent ring, a breathing glow, a live equalizer
     and a nudging arrow, so nobody misses it. Still under prefers-reduced-motion. */
  @property --album-ang { syntax: "<angle>"; inherits: false; initial-value: 0deg; }
  .hero__album { display: none; }
  :global(html.pae2) .hero__album {
    display: inline-flex; border: 2px solid transparent; color: var(--fg);
    background:
      linear-gradient(var(--bg-2), var(--bg-2)) padding-box,
      conic-gradient(from var(--album-ang), var(--accent), var(--accent-2), var(--accent-3), var(--accent)) border-box;
    animation: albumSpin 3.2s linear infinite, albumGlow 2.4s ease-in-out infinite, albumIn .7s var(--ease) 1.1s both;
  }
  :global(html.pae2) .hero__album:hover {
    background:
      linear-gradient(var(--surface-2), var(--surface-2)) padding-box,
      conic-gradient(from var(--album-ang), var(--accent), var(--accent-2), var(--accent-3), var(--accent)) border-box;
    border-color: transparent;
  }
  @keyframes albumSpin { to { --album-ang: 360deg; } }
  @keyframes albumGlow {
    0%, 100% { box-shadow: 0 0 0 0 rgba(var(--accent-rgb), 0), 0 8px 24px -10px rgba(var(--accent-2-rgb), .6); }
    50% { box-shadow: 0 0 0 7px rgba(var(--accent-rgb), .12), 0 10px 34px -8px rgba(var(--accent-2-rgb), .85); }
  }
  @keyframes albumIn { from { opacity: 0; transform: translateY(8px) scale(.96); } to { opacity: 1; transform: none; } }
  .hero__eq { display: inline-flex; align-items: flex-end; gap: 2px; width: 16px; height: 15px; }
  .hero__eq i { flex: 1; height: 40%; border-radius: 2px; background: linear-gradient(180deg, var(--accent-2), var(--accent)); animation: eqBar .9s ease-in-out infinite; }
  .hero__eq i:nth-child(2) { animation-duration: 1.1s; animation-delay: -.35s; }
  .hero__eq i:nth-child(3) { animation-duration: .8s; animation-delay: -.6s; }
  .hero__eq i:nth-child(4) { animation-duration: 1.2s; animation-delay: -.15s; }
  @keyframes eqBar { 0%, 100% { height: 25%; } 50% { height: 100%; } }
  .hero__album-label { display: inline-flex; align-items: center; gap: 10px; }
  .hero__album-badge {
    padding: 3px 8px; border-radius: 999px; font: 600 .66rem/1 var(--font-mono); letter-spacing: .08em; text-transform: uppercase;
    background: rgba(var(--accent-rgb), .16); color: var(--accent); border: 1px solid rgba(var(--accent-rgb), .3);
  }
  .hero__album .hero__album-arrow { animation: albumNudge 1.5s ease-in-out infinite; }
  .hero__album:hover .hero__album-arrow { transform: none; }
  @keyframes albumNudge { 0%, 100% { transform: translateY(-1px); } 50% { transform: translateY(3px); } }
  /* Phones: a full-width button, the song count under the name, and the name free to wrap rather
     than run off the screen. */
  @media (max-width: 520px) {
    :global(html.pae2) .hero__album { width: 100%; padding: 12px 18px; gap: 12px; white-space: normal; line-height: 1.2; text-align: left; }
    .hero__album-label { flex: 1 1 auto; min-width: 0; flex-direction: column; align-items: flex-start; gap: 5px; }
    .hero__eq, .hero__album-arrow { flex: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html.pae2) .hero__album, .hero__eq i, .hero__album .hero__album-arrow { animation: none; }
    .hero__eq i { height: 70%; }
  }
  .hero__tags { max-width: 620px; }
  .hero__tags-label { display: flex; align-items: center; gap: 8px; margin-bottom: 10px; font: 500 .72rem var(--font-mono); letter-spacing: .16em; text-transform: uppercase; color: var(--dim); }
  .hero__tags-label i { color: var(--accent); }
  .hero__tags-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 8px; }
  .hero__tag {
    display: flex; align-items: center; gap: 10px; padding: 8px 10px; border-radius: 12px; min-height: 44px;
    background: var(--surface); border: 1px solid var(--border); color: var(--fg);
    font: 500 .82rem/1.2 var(--font-body); letter-spacing: -.005em;
    animation: tagIn .6s var(--ease) backwards; animation-delay: calc(1000ms + var(--i) * 45ms);
    transition: border-color .3s var(--ease), background .3s var(--ease), transform .3s var(--ease);
  }
  .hero__tag:hover { border-color: rgba(var(--accent-rgb), .5); background: var(--surface-2); }
  @media (hover: hover) and (pointer: fine) { .hero__tag:hover { transform: translateY(-2px); } }
  @keyframes tagIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  .hero__tag-ico { flex: none; width: 28px; height: 28px; border-radius: 9px; display: inline-grid; place-items: center; font-size: .78rem; background: rgba(var(--accent-rgb), .14); color: var(--accent); }
  .hero__tag:nth-child(3n+2) .hero__tag-ico { background: rgba(var(--accent-2-rgb), .14); color: var(--accent-2); }
  .hero__tag:nth-child(3n) .hero__tag-ico { background: rgba(var(--accent-3-rgb), .14); color: var(--accent-3); }
  @media (max-width: 520px) { .hero__tags-grid { grid-template-columns: 1fr 1fr; } .hero__tag { font-size: .78rem; padding: 7px 9px; min-height: 42px; } }

  /* Portrait */
  .hero__visual { display: grid; place-items: center; min-width: 0; }
  /* The portrait is a cut-out PNG, so nothing here is a rectangle around it: a glass plinth
     sits behind the lower body, the head rises above it, and a canvas (see script) draws a
     gradient contour + glow that hugs the actual alpha edge of the photo, sends silhouette-
     shaped ripples outward, and follows the site's accent live. */
  .portrait { position: relative; width: min(400px, 78vw); aspect-ratio: 4 / 5; transition: transform .5s var(--ease); transform-style: preserve-3d; --px: 0; --py: 0; }
  .portrait__halo {
    position: absolute; inset: 8% -6% -8%; z-index: -1; border-radius: 50%; pointer-events: none;
    background: radial-gradient(50% 42% at 50% 62%, rgba(var(--accent-rgb), .55), rgba(var(--violet-rgb, var(--accent-rgb)), .25) 45%, transparent 72%);
    filter: blur(28px); animation: haloBreathe 9s ease-in-out infinite;
  }
  @keyframes haloBreathe { 50% { transform: scale(1.08) translateY(2%); opacity: .8; } }
  .portrait__plinth {
    position: absolute; left: 3%; right: 3%; top: 24%; bottom: 0; z-index: 0; overflow: hidden;
    border-radius: 30px; background: var(--grad-soft); border: 1px solid var(--border-strong);
    box-shadow: var(--shadow-card), inset 0 1px 0 rgba(255,255,255,.1), inset 0 -40px 60px -40px rgba(var(--accent-rgb), .35);
    transform: translate(calc(var(--px) * -5px), calc(var(--py) * -4px)); transition: transform .4s var(--ease);
  }
  .portrait__plinth::before {
    content: ""; position: absolute; inset: 0;
    background: radial-gradient(75% 55% at 50% 100%, rgba(var(--accent-rgb), .38), transparent 70%);
  }
  .portrait__grid {
    position: absolute; inset: 0; opacity: .35;
    background-image: linear-gradient(rgba(var(--accent-rgb), .18) 1px, transparent 1px), linear-gradient(90deg, rgba(var(--accent-rgb), .18) 1px, transparent 1px);
    background-size: 26px 26px; background-position: center bottom;
    mask-image: radial-gradient(80% 90% at 50% 100%, #000 20%, transparent 80%); -webkit-mask-image: radial-gradient(80% 90% at 50% 100%, #000 20%, transparent 80%);
  }
  .portrait__glint {
    position: absolute; top: 0; bottom: 0; width: 40%; left: -60%;
    background: linear-gradient(100deg, transparent 0%, rgba(255,255,255,.10) 45%, rgba(255,255,255,.18) 50%, rgba(255,255,255,.10) 55%, transparent 100%);
    transform: skewX(-12deg); animation: glint 9s var(--ease-io) infinite;
  }
  @keyframes glint { 0%, 55% { left: -60%; } 85%, 100% { left: 130%; } }
  .portrait__fx { position: absolute; inset: -9%; width: 118%; height: 118%; z-index: 1; pointer-events: none;
    mask-image: linear-gradient(to bottom, #000 80%, transparent 96%); -webkit-mask-image: linear-gradient(to bottom, #000 80%, transparent 96%); }
  .portrait__shots {
    position: absolute; inset: 0; z-index: 2; pointer-events: none;
    transform: translate(calc(var(--px) * 7px), calc(var(--py) * 5px)); transition: transform .4s var(--ease);
    mask-image: linear-gradient(to bottom, #000 78%, transparent 99%); -webkit-mask-image: linear-gradient(to bottom, #000 78%, transparent 99%);
  }
  .portrait__img {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; object-position: bottom center;
    opacity: 0; transition: opacity 1.2s var(--ease);
    filter: drop-shadow(0 22px 26px rgba(0,0,0,.45)) drop-shadow(0 0 1px rgba(var(--accent-rgb), .35));
  }
  .portrait__img.is-on { opacity: 1; }
  .portrait__scan {
    position: absolute; left: 0; right: 0; top: -20%; height: 16%; pointer-events: none;
    background: linear-gradient(180deg, transparent, rgba(var(--accent-3-rgb), .16), transparent);
    animation: scan 8s var(--ease-io) infinite;
  }
  .portrait__tag-s { display: none; }
  @keyframes scan { 0%, 25% { top: -20%; } 65%, 100% { top: 110%; } }
  .portrait__ring { position: absolute; inset: -8%; border-radius: 50%; border: 1px solid rgba(var(--accent-rgb), .25); z-index: -1; }
  .portrait__ring--a { animation: spin 26s linear infinite; border-style: dashed; }
  .portrait__ring--b { inset: -16%; border-color: rgba(var(--accent-2-rgb), .18); animation: spin 40s linear infinite reverse; }
  .portrait__orbit { position: absolute; inset: -8%; border-radius: 50%; animation: spin 12s linear infinite; z-index: 3; pointer-events: none; }
  .portrait__orbit span { position: absolute; top: -5px; left: 50%; width: 10px; height: 10px; margin-left: -5px; border-radius: 50%; background: var(--accent-3); box-shadow: 0 0 18px 4px rgba(var(--accent-3-rgb), .55); }
  @keyframes spin { to { transform: rotate(360deg); } }
  .portrait__tag {
    position: absolute; z-index: 4; display: inline-flex; align-items: center; gap: 8px;
    padding: 8px 12px; border-radius: 12px;
    background: color-mix(in oklab, var(--bg) 70%, transparent); border: 1px solid var(--border);
    backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    font: 500 .74rem var(--font-mono); color: var(--fg); white-space: nowrap;
    box-shadow: var(--shadow-card);
    animation: floaty 7s ease-in-out infinite;
  }
  .portrait__tag i { color: var(--accent-2); }
  .portrait__tag--tl { top: 30%; left: -14%; }
  .portrait__tag--br { bottom: 7%; right: -8%; animation-delay: -3.5s; }
  @keyframes floaty { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-7px); } }

  .hero__scroll {
    position: absolute; left: 50%; bottom: 22px; transform: translateX(-50%);
    display: flex; flex-direction: column; align-items: center; gap: 8px;
    color: var(--dim); text-decoration: none; font: 500 .68rem var(--font-mono); letter-spacing: .3em; text-transform: uppercase;
    opacity: 0; animation: fadeIn 1s ease forwards 1.6s;
  }
  .hero__scroll:hover { text-decoration: none; color: var(--fg); }
  .hero__mouse { width: 22px; height: 34px; border-radius: 12px; border: 1.5px solid currentColor; display: grid; justify-content: center; padding-top: 6px; }
  .hero__mouse span { width: 3px; height: 6px; border-radius: 2px; background: currentColor; animation: wheel 1.8s var(--ease) infinite; }
  @keyframes wheel { 0% { transform: translateY(0); opacity: 1; } 100% { transform: translateY(12px); opacity: 0; } }
  @keyframes fadeIn { to { opacity: 1; } }

  @media (max-width: 920px) {
    .hero { min-height: auto; padding-top: calc(var(--nav-h) + 30px); }
    .hero__grid { grid-template-columns: 1fr; }
    .hero__visual { order: -1; }
    .portrait { width: min(290px, 72vw); margin-top: 10px; }
    /* On narrow screens the tags hang off the plinth's edges instead of sitting over the face. */
    .portrait__tag--tl { top: 25%; left: -6%; font-size: .66rem; padding: 6px 10px; }
    .portrait__tag-l { display: none; } .portrait__tag-s { display: inline; }
    .portrait__tag--br { bottom: 4%; right: -6%; font-size: .66rem; padding: 6px 10px; }
    .hero__scroll { display: none; }
    .hero__title { font-size: clamp(3rem, 15vw, 5rem); }
  }
</style>

<script>
  // ---- Aurora canvas: four drifting light blobs, pointer-parallaxed ----------
  const cv = document.getElementById('aurora') as HTMLCanvasElement | null;
  if (cv) {
    const ctx = cv.getContext('2d')!;
    const W = 180, H = 110; cv.width = W; cv.height = H;
    const isLight = () => document.documentElement.dataset.theme === 'light';
    const blobs = [
      { x: .25, y: .35, r: .55, c: [79, 124, 255], s: .00021, p: 0 },
      { x: .7,  y: .3,  r: .5,  c: [139, 92, 246], s: .00017, p: 2 },
      { x: .55, y: .8,  r: .45, c: [255, 106, 61], s: .00015, p: 4 },
      { x: .15, y: .85, r: .4,  c: [62, 230, 176], s: .00019, p: 1 },
    ];
    let px = 0, py = 0, tpx = 0, tpy = 0, visible = true;
    addEventListener('pointermove', (e) => { tpx = (e.clientX / innerWidth - .5); tpy = (e.clientY / innerHeight - .5); }, { passive: true });
    new IntersectionObserver(([en]) => { visible = en.isIntersecting; }).observe(cv);
    const draw = (t: number) => {
      requestAnimationFrame(draw);
      if (!visible) return;
      px += (tpx - px) * .04; py += (tpy - py) * .04;
      ctx.globalCompositeOperation = 'source-over';
      ctx.fillStyle = isLight() ? '#f4f6fb' : '#07090f';
      ctx.fillRect(0, 0, W, H);
      ctx.globalCompositeOperation = isLight() ? 'multiply' : 'lighter';
      for (const b of blobs) {
        const x = (b.x + Math.sin(t * b.s + b.p) * .13 + px * .08) * W;
        const y = (b.y + Math.cos(t * b.s * 1.3 + b.p) * .11 + py * .08) * H;
        const r = b.r * W * (1 + Math.sin(t * b.s * .7 + b.p) * .12);
        const g = ctx.createRadialGradient(x, y, 0, x, y, r);
        const a = isLight() ? .3 : .42;
        g.addColorStop(0, `rgba(${b.c[0]},${b.c[1]},${b.c[2]},${a})`);
        g.addColorStop(1, `rgba(${b.c[0]},${b.c[1]},${b.c[2]},0)`);
        ctx.fillStyle = g; ctx.beginPath(); ctx.arc(x, y, r, 0, Math.PI * 2); ctx.fill();
      }
    };
    requestAnimationFrame(draw);
  }

  // ---- Role rotator with scramble effect ---------------------------------
  const rot = document.getElementById('rotator');
  if (rot) {
    const roles: string[] = JSON.parse(rot.dataset.roles || '[]');
    const glyphs = '!<>-_\\/[]{}—=+*^?#0123456789';
    let i = 0, busy = false;
    const scramble = (to: string) => new Promise<void>((res) => {
      rot.classList.add('is-scrambling');
      const from = rot.textContent || '';
      const len = Math.max(from.length, to.length);
      const q = Array.from({ length: len }, (_, k) => ({ from: from[k] || '', to: to[k] || '', start: Math.floor(Math.random() * 14), end: Math.floor(Math.random() * 14) + 14, ch: '' }));
      let frame = 0;
      const step = () => {
        let out = '', done = 0;
        for (const s of q) {
          if (frame >= s.end) { done++; out += s.to; }
          else if (frame >= s.start) { if (!s.ch || Math.random() < .28) s.ch = glyphs[Math.floor(Math.random() * glyphs.length)]; out += `<span class="scr">${s.ch}</span>`; }
          else out += s.from;
        }
        rot.innerHTML = out;
        if (done === q.length) { rot.classList.remove('is-scrambling'); res(); } else { frame++; requestAnimationFrame(step); }
      };
      step();
    });
    const article = document.getElementById('rotator-article');
    const setArticle = (role: string) => { if (article) article.textContent = /^[aeiou]/i.test(role) ? "I'm an" : "I'm a"; };
    setArticle(roles[0] || '');
    setInterval(async () => {
      if (busy || document.hidden) return;
      busy = true; i = (i + 1) % roles.length;
      setArticle(roles[i]);
      await scramble(roles[i]); busy = false;
    }, 2800);
  }

  // ---- Portrait: crossfade + edge-hugging contour FX -------------------------
  // The contour is computed from the PNG's real alpha: the silhouette is stamped around a small
  // circle to dilate it, the original is punched back out, and what's left is a ring that hugs
  // every edge of the cut-out. Each frame that ring is filled with a slowly turning conic
  // gradient (accent → violet → ember → mint, plus one bright "comet" sector) and a blurred copy
  // becomes the glow. Silhouette-shaped ripples expand outward every few seconds and on hover.
  const a = document.getElementById('portrait-a') as HTMLImageElement | null;
  const b = document.getElementById('portrait-b') as HTMLImageElement | null;
  const fx = document.getElementById('portrait-fx') as HTMLCanvasElement | null;
  const portrait = document.getElementById('portrait') as HTMLElement | null;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let onA = true;
  if (a && b) setInterval(() => { onA = !onA; a.classList.toggle('is-on', onA); b.classList.toggle('is-on', !onA); }, 8000);

  if (fx && portrait && a && b) {
    const ctx = fx.getContext('2d')!;
    type Ring = { sharp: HTMLCanvasElement; glow: HTMLCanvasElement };
    let rings: (Ring | null)[] = [null, null];
    let W = 0, H = 0, weightA = 1;
    const dpr = Math.min(devicePixelRatio || 1, 1.5);
    const tmp = document.createElement('canvas'), tctx = tmp.getContext('2d')!;
    const echoes: number[] = [];
    let colors = { accent: '#4f7cff', violet: '#8b5cf6', ember: '#f97316', mint: '#22c55e' };
    const readColors = () => {
      const cs = getComputedStyle(document.documentElement);
      const v = (n: string, fb: string) => (cs.getPropertyValue(n).trim() || fb);
      colors = { accent: v('--accent', colors.accent), violet: v('--violet', colors.violet), ember: v('--accent-2', colors.ember), mint: v('--accent-3', colors.mint) };
    };
    readColors();
    new MutationObserver(readColors).observe(document.documentElement, { attributes: true, attributeFilter: ['style', 'data-theme'] });

    // Where the <img> (object-fit: contain, bottom center) lands inside the portrait box, in canvas px.
    const imgRect = (img: HTMLImageElement) => {
      const pr = portrait.getBoundingClientRect(), fr = fx.getBoundingClientRect();
      const bw = pr.width, bh = pr.height;
      const sc = Math.min(bw / img.naturalWidth, bh / img.naturalHeight);
      const dw = img.naturalWidth * sc, dh = img.naturalHeight * sc;
      const x = (pr.left - fr.left) + (bw - dw) / 2, y = (pr.top - fr.top) + (bh - dh);
      return { x: x * dpr, y: y * dpr, w: dw * dpr, h: dh * dpr };
    };
    const buildRing = (img: HTMLImageElement): Ring => {
      const r = imgRect(img);
      const rad = Math.max(2, W * 0.011);
      const sharp = document.createElement('canvas'); sharp.width = W; sharp.height = H;
      const sctx = sharp.getContext('2d')!;
      for (let k = 0; k < 24; k++) {
        const ang = (k / 24) * Math.PI * 2;
        sctx.drawImage(img, r.x + Math.cos(ang) * rad, r.y + Math.sin(ang) * rad, r.w, r.h);
      }
      sctx.globalCompositeOperation = 'destination-out';
      sctx.drawImage(img, r.x, r.y, r.w, r.h);
      const glow = document.createElement('canvas'); glow.width = W; glow.height = H;
      const gctx = glow.getContext('2d')!;
      gctx.filter = `blur(${Math.max(6, W * 0.028)}px)`;
      gctx.drawImage(sharp, 0, 0);
      gctx.filter = 'none';
      gctx.drawImage(sharp, 0, 0);
      return { sharp, glow };
    };
    const rebuild = () => {
      const fr = fx.getBoundingClientRect();
      W = Math.round(fr.width * dpr); H = Math.round(fr.height * dpr);
      if (!W || !H) return;
      fx.width = W; fx.height = H; tmp.width = W; tmp.height = H;
      rings = [a, b].map((img) => (img.complete && img.naturalWidth ? buildRing(img) : null));
    };
    const fillRing = (ring: HTMLCanvasElement, angle: number, alpha: number, cx: number, cy: number) => {
      tctx.globalCompositeOperation = 'source-over';
      tctx.clearRect(0, 0, W, H);
      const g = tctx.createConicGradient(angle, cx, cy);
      g.addColorStop(0, colors.accent); g.addColorStop(.22, colors.violet); g.addColorStop(.45, colors.ember);
      g.addColorStop(.62, '#ffffff'); g.addColorStop(.66, colors.mint); g.addColorStop(.85, colors.accent); g.addColorStop(1, colors.accent);
      tctx.fillStyle = g; tctx.fillRect(0, 0, W, H);
      tctx.globalCompositeOperation = 'destination-in';
      tctx.drawImage(ring, 0, 0);
      ctx.globalAlpha = alpha;
      ctx.drawImage(tmp, 0, 0);
      ctx.globalAlpha = 1;
    };
    let last = 0, nextEcho = performance.now() + 2500, visible = true, raf = 0;
    const frame = (t: number) => {
      raf = requestAnimationFrame(frame);
      if (!visible || document.hidden || !W) return;
      if (t - last < 1000 / 45) return; // ~45fps is plenty for a slow sweep
      last = t;
      weightA += ((onA ? 1 : 0) - weightA) * 0.06;
      ctx.clearRect(0, 0, W, H);
      const cx = W / 2, cy = H * 0.55, ang = (t / 9000) * Math.PI * 2;
      if (t > nextEcho) { echoes.push(t); nextEcho = t + 6500 + Math.random() * 2500; }
      rings.forEach((ring, i) => {
        if (!ring) return;
        const w = i === 0 ? weightA : 1 - weightA;
        if (w < 0.02) return;
        fillRing(ring.glow, ang, 0.55 * w, cx, cy);
        fillRing(ring.sharp, ang, 0.95 * w, cx, cy);
        for (let e = echoes.length - 1; e >= 0; e--) {
          const p = (t - echoes[e]) / 1600;
          if (p >= 1) { echoes.splice(e, 1); continue; }
          const sc = 1 + p * 0.16, k = (1 - p) * (1 - p) * 0.5 * w;
          ctx.save(); ctx.globalAlpha = k; ctx.translate(cx, cy * 1.35); ctx.scale(sc, sc); ctx.translate(-cx, -cy * 1.35);
          ctx.drawImage(tmp, 0, 0); ctx.restore();
        }
      });
    };
    const start = async () => {
      await Promise.all([a, b].map((img) => (img.complete ? Promise.resolve() : new Promise<void>((res) => { img.onload = () => res(); img.onerror = () => res(); }))));
      rebuild();
      if (reduced) { frame(performance.now()); cancelAnimationFrame(raf); return; }
      raf = requestAnimationFrame(frame);
    };
    start();
    let rt = 0;
    addEventListener('resize', () => { clearTimeout(rt); rt = setTimeout(rebuild, 150); });
    new IntersectionObserver((en) => { visible = en[0]?.isIntersecting ?? true; }).observe(fx);
    portrait.addEventListener('pointerenter', () => { echoes.push(performance.now()); nextEcho = performance.now() + 7000; });
    portrait.addEventListener('pointerdown', () => echoes.push(performance.now()));

    // Depth: photo and plinth drift in opposite directions under the pointer (desktop only).
    if (matchMedia('(pointer: fine)').matches) {
      portrait.addEventListener('pointermove', (e) => {
        const r = portrait.getBoundingClientRect();
        portrait.style.setProperty('--px', String(((e.clientX - r.left) / r.width - 0.5) * 2));
        portrait.style.setProperty('--py', String(((e.clientY - r.top) / r.height - 0.5) * 2));
      });
      portrait.addEventListener('pointerleave', () => { portrait.style.setProperty('--px', '0'); portrait.style.setProperty('--py', '0'); });
    }
  }
</script>

<style is:global>
  .hero__rotator .scr { display: inline-block; color: var(--accent-2); opacity: .85; animation: scrJit .09s steps(2) infinite; }
  @keyframes scrJit { 0% { transform: translateY(-1px) skewX(-6deg); opacity: .6; } 100% { transform: translateY(1px) skewX(4deg); opacity: .95; } }
</style>

---
// The home page's single "Work" section: the OpenVibe network and the project archive in one
// place, split into clearly labelled groups (each with its own color, header and "view all")
// instead of a separate network section followed by an ungrouped grid. Cards are deliberately
// compact — one line of title, two of summary — with the full case notes one click away.
import { getCollection } from "astro:content";
import profile from "../data/profile.json";

const all = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const byCats = (cats: string[], n: number) =>
  all.filter((p) => cats.includes(p.data.category)).sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.order - b.data.order).slice(0, n);
const countCats = (cats: string[]) => all.filter((p) => cats.includes(p.data.category)).length;

const catLabel: Record<string, string> = {
  openvibe: "OpenVibe", powerchat: "PowerChat", amazon: "Amazon", ai: "AI", infra: "Infra & ops",
  game: "Games", tools: "Tools", python: "Python", hardware: "Hardware", web: "Web",
};
const netIcon: Record<string, string> = {
  live: "fa-solid fa-tower-broadcast", network: "fa-solid fa-id-badge", media: "fa-solid fa-photo-film", tools: "fa-solid fa-toolbox",
  games: "fa-solid fa-gamepad", community: "fa-solid fa-comments", sites: "fa-solid fa-globe",
};

const groups = [
  {
    key: "openvibe", tone: "a", anchor: "network", icon: "fa-solid fa-diagram-project",
    title: "The OpenVibe network", blurb: "Seven live services behind one sign-in, all built and run by me since 2026.",
    count: profile.network.length, allHref: "/portfolio/?cat=openvibe,infra", allLabel: "All OpenVibe case notes",
    items: profile.network.map((n) => ({ href: n.url, external: true, image: n.image, icon: netIcon[n.key] ?? "fa-solid fa-cube", title: n.name, sub: n.role, text: n.blurb, meta: n.stat })),
  },
  {
    key: "powerchat", tone: "b", icon: "fa-solid fa-bolt",
    title: "PowerChat", blurb: "Contract platform work for a creator-monetization product: payments and the developer API.",
    count: countCats(["powerchat"]), allHref: "/portfolio/?cat=powerchat", allLabel: "All PowerChat work",
    items: byCats(["powerchat"], 4).map((p) => ({ href: `/portfolio/${p.slug}`, external: false, icon: p.data.icon ?? "fa-solid fa-cube", title: p.data.title, sub: catLabel[p.data.category], text: p.data.summary, meta: p.data.year ?? "" })),
  },
  {
    key: "ai", tone: "c", icon: "fa-solid fa-robot",
    title: "AI, data & automation", blurb: "Agents, analytics and tooling that did real work at Amazon and inside OpenVibe.",
    count: countCats(["ai", "amazon"]), allHref: "/portfolio/?cat=ai,amazon", allLabel: "All AI & data work",
    items: byCats(["ai", "amazon"], 4).map((p) => ({ href: `/portfolio/${p.slug}`, external: false, icon: p.data.icon ?? "fa-solid fa-cube", title: p.data.title, sub: catLabel[p.data.category], text: p.data.summary, meta: p.data.year ?? "" })),
  },
  {
    key: "more", tone: "d", icon: "fa-solid fa-shapes",
    title: "Games, tools & side projects", blurb: "The builds that keep the tools sharp: a multiplayer game, desktop apps, hardware and utilities.",
    count: countCats(["game", "tools", "python", "hardware", "web"]), allHref: "/portfolio/", allLabel: "The whole archive",
    items: byCats(["game", "tools", "python", "hardware", "web"], 4).map((p) => ({ href: `/portfolio/${p.slug}`, external: false, icon: p.data.icon ?? "fa-solid fa-cube", title: p.data.title, sub: catLabel[p.data.category], text: p.data.summary, meta: p.data.year ?? "" })),
  },
];
---
<section class="section work" id="work" aria-labelledby="work-title">
  <div class="container">
    <div class="sec-head">
      <span class="sec-num" aria-hidden="true">02</span>
      <div>
        <div class="sec-index">Work</div>
        <h2 class="sec-title" id="work-title">Things I <em>shipped</em>, grouped.</h2>
      </div>
      <p class="sec-lead">Four groups, short cards, real links. Every card opens the case notes; every OpenVibe tile opens the live site.</p>
    </div>

    <div class="wk">
      {groups.map((g, gi) => (
        <section class={`wk-group wk-group--${g.tone}`} id={g.anchor} aria-labelledby={`wk-${g.key}`} data-reveal style={`--i:${gi}`}>
          <header class="wk-group__head">
            <span class="wk-group__ico"><i class={g.icon} aria-hidden="true"></i></span>
            <div class="wk-group__txt">
              <h3 class="wk-group__title" id={`wk-${g.key}`}>{g.title} <span class="wk-group__n mono">{g.count}</span></h3>
              <p class="wk-group__blurb">{g.blurb}</p>
            </div>
            <a class="wk-group__all" href={g.allHref}><i class="fa-solid fa-grip" aria-hidden="true"></i> <span>{g.allLabel}</span> <i class="fa-solid fa-arrow-right wk-group__arrow" aria-hidden="true"></i></a>
          </header>
          <ul class="wk-grid" data-stagger>
            {g.items.map((it) => (
              <li class={`wk-card ${it.image ? "wk-card--img" : ""}`}>
                <a href={it.href} class="wk-card__link" target={it.external ? "_blank" : undefined} rel={it.external ? "noopener" : undefined}>
                  {it.image && <span class="wk-card__thumb" aria-hidden="true"><img src={it.image} alt="" loading="lazy" width="640" height="240" /></span>}
                  <span class="wk-card__body">
                    <span class="wk-card__top">
                      <span class="wk-card__ico"><i class={it.icon} aria-hidden="true"></i></span>
                      {!it.image && <span class="wk-card__sub">{it.sub}</span>}
                      {it.meta && <span class="wk-card__meta mono">{it.meta}</span>}
                    </span>
                    <span class="wk-card__title">{it.title}</span>
                    {it.image && <span class="wk-card__role">{it.sub}</span>}
                    <span class="wk-card__text">{it.text}</span>
                    <span class="wk-card__go"><span>{it.external ? "Open site" : "Case notes"}</span> <i class={it.external ? "fa-solid fa-arrow-up-right-from-square" : "fa-solid fa-arrow-right"} aria-hidden="true"></i></span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>

    <div class="work__more" data-reveal="scale">
      <a href="/portfolio/" class="work__all-btn" data-magnetic>
        <span class="work__all-ico"><i class="fa-solid fa-layer-group"></i></span>
        <span class="work__all-text">
          <strong>See all {all.length} projects and every website</strong>
          <small>Filter by area, open the case notes, or jump straight to the live sites</small>
        </span>
        <span class="work__all-go" aria-hidden="true"><i class="fa-solid fa-arrow-right"></i></span>
      </a>
    </div>
  </div>
</section>

<style>
  .wk { display: grid; gap: clamp(18px, 3vw, 30px); }
  /* Each group carries its own tone so the eye can tell them apart mid-scroll: a colored icon
     square, a matching left rule and a faint tinted background. */
  .wk-group { --g: var(--accent); --g-rgb: var(--accent-rgb); position: relative; padding: clamp(16px, 2.4vw, 24px); border-radius: var(--radius-lg); background: linear-gradient(135deg, rgba(var(--g-rgb), .07), transparent 55%), var(--surface); border: 1px solid var(--border); scroll-margin-top: 90px; }
  .wk-group::before { content: ""; position: absolute; left: -1px; top: 18%; bottom: 18%; width: 3px; border-radius: 3px; background: var(--g); box-shadow: 0 0 18px rgba(var(--g-rgb), .7); }
  .wk-group--b { --g: var(--accent-2); --g-rgb: var(--accent-2-rgb); }
  .wk-group--c { --g: var(--accent-3); --g-rgb: var(--accent-3-rgb); }
  .wk-group--d { --g: var(--violet); --g-rgb: 139, 92, 246; }
  .wk-group__head { display: grid; grid-template-columns: auto 1fr auto; gap: 14px 16px; align-items: center; margin-bottom: 16px; }
  .wk-group__ico { width: 44px; height: 44px; border-radius: 14px; display: grid; place-items: center; background: rgba(var(--g-rgb), .14); color: var(--g); border: 1px solid rgba(var(--g-rgb), .3); font-size: 1.05rem; box-shadow: 0 10px 24px -14px rgba(var(--g-rgb), .9); }
  .wk-group__txt { min-width: 0; }
  .wk-group__title { margin: 0; font-size: clamp(1.15rem, 2vw, 1.45rem); display: flex; align-items: center; gap: 10px; }
  .wk-group__n { font-size: .72rem; padding: 2px 8px; border-radius: 999px; background: rgba(var(--g-rgb), .14); color: var(--g); border: 1px solid rgba(var(--g-rgb), .3); }
  .wk-group__blurb { margin: 3px 0 0; color: var(--muted); font-size: .92rem; line-height: 1.5; }
  .wk-group__all { display: inline-flex; align-items: center; gap: 8px; padding: 9px 14px; border-radius: 999px; border: 1px solid rgba(var(--g-rgb), .35); background: rgba(var(--g-rgb), .08); color: var(--fg); font: 600 .8rem var(--font-body); text-decoration: none; white-space: nowrap; transition: background .3s var(--ease), border-color .3s var(--ease), transform .3s var(--ease); }
  .wk-group__all i:first-child { color: var(--g); }
  .wk-group__arrow { transition: transform .3s var(--ease); font-size: .75rem; }
  .wk-group__all:hover { text-decoration: none; background: rgba(var(--g-rgb), .16); border-color: rgba(var(--g-rgb), .6); transform: translateY(-1px); }
  .wk-group__all:hover .wk-group__arrow { transform: translateX(3px); }

  .wk-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
  .wk-card { min-width: 0; }
  .wk-card__link { display: flex; flex-direction: column; height: 100%; border-radius: 16px; overflow: hidden; background: var(--surface); border: 1px solid var(--border); color: var(--fg); text-decoration: none; transition: transform .4s var(--ease), border-color .3s var(--ease), box-shadow .4s var(--ease), background .3s var(--ease); }
  .wk-card__link:hover { text-decoration: none; transform: translateY(-3px); border-color: rgba(var(--g-rgb), .5); background: var(--surface-2); box-shadow: var(--shadow-card), 0 0 0 1px rgba(var(--g-rgb), .12), 0 16px 40px -22px rgba(var(--g-rgb), .7); }
  .wk-card__thumb { display: block; aspect-ratio: 16 / 6; overflow: hidden; background: var(--bg-2); border-bottom: 1px solid var(--border); }
  .wk-card__thumb img { width: 100%; height: 100%; object-fit: cover; object-position: top; transition: transform 1s var(--ease); }
  .wk-card__link:hover .wk-card__thumb img { transform: scale(1.06); }
  .wk-card__body { display: flex; flex-direction: column; gap: 6px; padding: 12px 13px 12px; flex: 1; }
  .wk-card__top { display: flex; align-items: center; gap: 8px; }
  .wk-card__ico { width: 28px; height: 28px; border-radius: 9px; display: inline-grid; place-items: center; background: rgba(var(--g-rgb), .13); color: var(--g); font-size: .78rem; flex: none; }
  .wk-card__sub { font: 500 .66rem var(--font-mono); letter-spacing: .12em; text-transform: uppercase; color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .wk-card__meta { margin-left: auto; font-size: .66rem; color: var(--dim); white-space: nowrap; }
  .wk-card__title { font: 700 .98rem/1.25 var(--font-display); letter-spacing: -.01em; }
  .wk-card__role { font: 500 .66rem var(--font-mono); letter-spacing: .12em; text-transform: uppercase; color: var(--g); margin-top: -2px; }
  .wk-card__text { color: var(--muted); font-size: .82rem; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .wk-card__go { margin-top: auto; padding-top: 4px; display: inline-flex; align-items: center; gap: 6px; font: 600 .72rem var(--font-mono); color: var(--g); }
  .wk-card__go i { transition: transform .3s var(--ease); font-size: .7rem; }
  .wk-card__link:hover .wk-card__go i { transform: translateX(3px); }
  .mono { font-family: var(--font-mono); }

  .work__more { margin-top: clamp(22px, 3vw, 34px); display: flex; justify-content: center; }
  .work__all-btn {
    position: relative; z-index: 1; display: flex; align-items: center; gap: 18px;
    width: min(640px, 100%); padding: 22px 26px; border-radius: 22px;
    background: var(--surface); border: 1px solid var(--border-strong);
    text-decoration: none; color: var(--fg); box-shadow: var(--shadow-card);
    transition: transform .4s var(--ease), border-color .4s var(--ease), box-shadow .4s var(--ease), background .4s var(--ease);
  }
  .work__all-btn:hover { text-decoration: none; transform: translateY(-4px) scale(1.015); border-color: rgba(var(--accent-rgb), .55); box-shadow: var(--shadow-card), var(--shadow-glow); background: var(--surface-2); }
  .work__all-ico { flex: none; width: 52px; height: 52px; border-radius: 16px; display: grid; place-items: center; background: var(--grad); color: var(--on-accent); font-size: 1.25rem; box-shadow: var(--shadow-glow); animation: workAllPulse 2.6s var(--ease) infinite; }
  @keyframes workAllPulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.08); } }
  .work__all-text { flex: 1; min-width: 0; display: grid; gap: 3px; }
  .work__all-text strong { font-family: var(--font-display); font-size: 1.2rem; letter-spacing: -.01em; }
  .work__all-text small { color: var(--muted); font-size: .86rem; line-height: 1.4; }
  .work__all-go { flex: none; width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; color: var(--accent); border: 1px solid rgba(var(--accent-rgb), .3); background: rgba(var(--accent-rgb), .08); transition: transform .4s var(--ease), background .3s; }
  .work__all-btn:hover .work__all-go { transform: translateX(5px); background: rgba(var(--accent-rgb), .16); }

  @media (max-width: 1100px) { .wk-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 820px) { .wk-grid { grid-template-columns: repeat(2, 1fr); } .wk-group__head { grid-template-columns: auto 1fr; } .wk-group__all { grid-column: 1 / -1; justify-self: start; } }
  @media (max-width: 480px) { .wk-grid { grid-template-columns: 1fr 1fr; gap: 8px; } .wk-card__body { padding: 10px 11px; } .wk-card__text { display: none; } .wk-card__title { font-size: .9rem; } .wk-card--img .wk-card__meta { display: none; } .work__all-btn { padding: 18px; gap: 14px; } .work__all-ico { width: 44px; height: 44px; font-size: 1.05rem; } }
</style>

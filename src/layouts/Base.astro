---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import ThemePicker from "../components/ThemePicker.astro";
import profile from "../data/profile.json";
import themePresets from "../data/theme-presets.json";
import themePdfManifest from "../data/theme-pdf-manifest.json";
import linkPreviews from "../data/link-previews.json";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  type?: string;
}

const {
  title = "Alex Frison — Software Engineer · Platform Architect · Founder of OpenVibe",
  description = "Alex Frison: Pacific Northwest software engineer and founder of the OpenVibe network (live streaming, identity, media, 169 tools, games). Contract engineer at PowerChat building its developer platform and payments. Formerly Amazon ICQA analytics.",
  image = "/assets/img/og.png",
  canonical,
  type = "website",
} = Astro.props;

const site = Astro.site ?? new URL("https://alexfrison.net");
const pageUrl = canonical ?? new URL(Astro.url.pathname, site).toString();
const imageUrl = new URL(image, site).toString();
---
<!doctype html>
<html lang="en" data-theme="dark" class="no-js">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={pageUrl} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <meta name="theme-color" content="#07090f" />
  <meta name="color-scheme" content="dark light" />

  <meta property="og:type" content={type} />
  <meta property="og:site_name" content="Alex Frison" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={imageUrl} />
  <meta property="og:url" content={pageUrl} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={imageUrl} />
  <meta name="robots" content="index, follow" />
  <meta name="author" content="Alex Frison" />
  <meta name="keywords" content="Alex Frison, Software Engineer, Platform Architect, OpenVibe, Live Streaming, WebRTC, RTMP, OAuth2, OIDC, Payments, Stripe, Node.js, TypeScript, Seattle, Arlington WA, Pacific Northwest, Founding Engineer, AI Agents, Data Analyst, Amazon ICQA, SOX" />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    name: profile.name,
    url: profile.site,
    email: profile.email,
    telephone: profile.phone,
    image: `${profile.site}/assets/img/me-cut1.png`,
    jobTitle: "Software Engineer · Platform Architect · Founder of OpenVibe",
    description: profile.pitch,
    worksFor: [
      { "@type": "Organization", name: "PowerChat", url: "https://powerchat.live" },
      { "@type": "Organization", name: "OpenVibe", url: "https://openvibe.live" },
    ],
    knowsAbout: ["Live streaming infrastructure", "WebRTC", "RTMP", "OAuth2", "OIDC", "Payments systems", "Node.js", "TypeScript", "PostgreSQL", "SQLite", "Redis", "ffmpeg", "LLM tooling", "SQL analytics", "Linux", "nginx", "systemd"],
    address: { "@type": "PostalAddress", addressLocality: "Arlington", addressRegion: "WA", addressCountry: "US" },
    sameAs: [profile.github, profile.linkedin],
  })} />

  <link rel="preload" href="/assets/vendor/fonts/space-grotesk-700.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/assets/vendor/fonts/inter-400.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href="/assets/vendor/fontawesome/css/all.min.css" />
  <link rel="stylesheet" href="/assets/vendor/lenis/lenis.css" />

  <script is:inline define:vars={{ themePresets, themePdfManifest }}>
    // Theme before paint (no flash) and JS marker for reveal fallbacks
    (function () {
      var d = document.documentElement;
      d.classList.remove('no-js');
      try {
        var t = localStorage.getItem('afnet-theme');
        if (t === 'light' || t === 'dark') d.dataset.theme = t;
      } catch (e) {}

      // ---- Accent color system --------------------------------------------------------
      // One "favorite color" (a plain hex) drives every accent on the site. Everything else
      // (violet, ember, mint) is a hue rotation off it, so the palette always reads as one
      // family instead of a picked color plus three unrelated leftovers. Exposed on window so
      // the picker component (loaded later, on demand) can call the same function instead of
      // redefining this math — this copy only exists to run before first paint.
      function hexToHsl(hex) {
        hex = hex.replace('#', '');
        var r = parseInt(hex.substr(0, 2), 16) / 255, g = parseInt(hex.substr(2, 2), 16) / 255, b = parseInt(hex.substr(4, 2), 16) / 255;
        var max = Math.max(r, g, b), min = Math.min(r, g, b), h, s, l = (max + min) / 2;
        if (max === min) { h = s = 0; }
        else {
          var d2 = max - min;
          s = l > 0.5 ? d2 / (2 - max - min) : d2 / (max + min);
          if (max === r) h = (g - b) / d2 + (g < b ? 6 : 0);
          else if (max === g) h = (b - r) / d2 + 2;
          else h = (r - g) / d2 + 4;
          h /= 6;
        }
        return [h * 360, s * 100, l * 100];
      }
      function hslToHex(h, s, l) {
        h = ((h % 360) + 360) % 360; s /= 100; l /= 100;
        var c = (1 - Math.abs(2 * l - 1)) * s, x = c * (1 - Math.abs((h / 60) % 2 - 1)), m = l - c / 2, r, g, b;
        if (h < 60) { r = c; g = x; b = 0; } else if (h < 120) { r = x; g = c; b = 0; } else if (h < 180) { r = 0; g = c; b = x; }
        else if (h < 240) { r = 0; g = x; b = c; } else if (h < 300) { r = x; g = 0; b = c; } else { r = c; g = 0; b = x; }
        function toHex(v) { var s2 = Math.round((v + m) * 255).toString(16); return s2.length < 2 ? '0' + s2 : s2; }
        return '#' + toHex(r) + toHex(g) + toHex(b);
      }
      function hexToRgbStr(hex) {
        hex = hex.replace('#', '');
        return parseInt(hex.substr(0, 2), 16) + ', ' + parseInt(hex.substr(2, 2), 16) + ', ' + parseInt(hex.substr(4, 2), 16);
      }
      // Any palette change — accent or light/dark — briefly puts the document in a state
      // where every color-ish property transitions, so the swap reads as a smooth wash across
      // the page instead of a hard cut. The class is removed after the transition window.
      var themingTimer = 0;
      function withThemeTransition(fn) {
        try {
          if (matchMedia('(prefers-reduced-motion: reduce)').matches) { fn(); return; }
        } catch (e) {}
        d.classList.add('is-theming');
        fn();
        clearTimeout(themingTimer);
        themingTimer = setTimeout(function () { d.classList.remove('is-theming'); }, 720);
      }
      window.__ovWithThemeTransition = withThemeTransition;
      function applyAccent(hex, animate) {
        if (!/^#[0-9a-f]{6}$/i.test(hex)) return;
        if (animate) { withThemeTransition(function () { applyAccent(hex, false); }); return; }
        var hsl = hexToHsl(hex), h = hsl[0];
        // Clamp saturation/lightness so a very dark or very pale pick still reads as an accent
        // (not black text or an invisible near-white) in both themes.
        // Toned down from the first version: saturation capped lower and lightness kept in a
        // narrower band, so picks stop reading as pure neon slabs and derived colors sit in
        // the same, slightly desaturated family.
        var accent = hslToHex(h, Math.max(48, Math.min(hsl[1], 76)), Math.max(46, Math.min(hsl[2], 62)));
        var violet = hslToHex(h + 40, 56, 62);
        var ember = hslToHex(h + 180, 64, 60);
        var mint = hslToHex(h + 150, 54, 52);
        var root = d.style;
        // Text on top of the accent: relative luminance decides dark ink vs white.
        var rgb = hexToRgbStr(accent).split(', ').map(function (v) { v = parseInt(v, 10) / 255; return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4); });
        var lum = 0.2126 * rgb[0] + 0.7152 * rgb[1] + 0.0722 * rgb[2];
        root.setProperty('--on-accent', lum > 0.36 ? '#0b0f1a' : '#ffffff');
        root.setProperty('--accent', accent);
        root.setProperty('--accent-rgb', hexToRgbStr(accent));
        root.setProperty('--violet', violet);
        root.setProperty('--accent-2', ember);
        root.setProperty('--accent-2-rgb', hexToRgbStr(ember));
        root.setProperty('--accent-3', mint);
        root.setProperty('--accent-3-rgb', hexToRgbStr(mint));
      }
      window.__ovApplyAccent = applyAccent;
      try {
        var fav = localStorage.getItem('ov_fav_color');
        if (fav) applyAccent(fav);
      } catch (e) {}

      // ---- Resume PDF matching -----------------------------------------------------------
      // Every "Download PDF" link (nav, footer, contact, hero, resume page) points at the
      // build-time default (blue) file by default. Once a visitor has picked a favorite color,
      // point those same links at the pre-generated PDF for the preset nearest that color's hue,
      // so the file they download actually matches the site they're looking at. Defined here
      // (data is only available server-side, at layout render time) but invoked later, once
      // [data-resume-link] elements exist in the DOM — see the deferred script below.
      var THEME_PRESETS = themePresets;
      var THEME_PDF_MANIFEST = themePdfManifest;
      function nearestPresetName(hex) {
        var h = hexToHsl(hex)[0], best = null, bestDist = Infinity;
        for (var i = 0; i < THEME_PRESETS.length; i++) {
          var dh = Math.abs(hexToHsl(THEME_PRESETS[i].hex)[0] - h);
          dh = Math.min(dh, 360 - dh);
          if (dh < bestDist) { bestDist = dh; best = THEME_PRESETS[i].name; }
        }
        return best;
      }
      window.__ovApplyResumeLinks = function (hex) {
        if (!/^#[0-9a-f]{6}$/i.test(hex)) return;
        var path = THEME_PDF_MANIFEST[nearestPresetName(hex)] || THEME_PDF_MANIFEST.default;
        if (!path) return;
        document.querySelectorAll('[data-resume-link]').forEach(function (a) { a.setAttribute('href', path); });
      };
    })();
  </script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <div class="progress" aria-hidden="true"></div>
  <div class="cursor" aria-hidden="true"></div>
  <Nav />
  <main id="main"><slot /></main>
  <Footer />
  <ThemePicker />
  <div class="lp" id="lp" aria-hidden="true"><div class="lp__img"><img alt="" decoding="async" /></div><div class="lp__cap"><i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i><span></span></div></div>
  <script type="application/json" id="lp-data" set:html={JSON.stringify(linkPreviews)} />

  <script>
    // ---- Resume PDF links: match whatever color was picked before paint ---
    try {
      const fav = localStorage.getItem('ov_fav_color');
      if (fav) (window as any).__ovApplyResumeLinks?.(fav);
    } catch { /* */ }

    // ---- Smooth scroll (Lenis) --------------------------------------------
    const lenisScript = document.createElement('script');
    lenisScript.src = '/assets/vendor/lenis/lenis.min.js';
    lenisScript.onload = () => {
      // @ts-ignore
      const L = window.Lenis;
      // Wheel/trackpad only. Smoothing touch scroll felt laggy on phones and swallowed
      // Chrome's pull-to-refresh, so touch stays fully native.
      if (!L || matchMedia('(pointer: coarse)').matches) return;
      const lenis = new L({ lerp: 0.11, wheelMultiplier: 0.95, smoothWheel: true });
      // @ts-ignore
      window.__lenis = lenis;
      const raf = (t: number) => { lenis.raf(t); requestAnimationFrame(raf); };
      requestAnimationFrame(raf);
      document.addEventListener('click', (e) => {
        const a = (e.target as HTMLElement).closest('a[href^="#"], a[href^="/#"]') as HTMLAnchorElement | null;
        if (!a) return;
        const hash = a.getAttribute('href')!.replace(/^\//, '');
        if (hash === '#' || location.pathname !== '/' && a.getAttribute('href')!.startsWith('/#')) return;
        const target = document.querySelector(hash);
        if (!target) return;
        e.preventDefault();
        lenis.scrollTo(target as HTMLElement, { offset: -80, duration: 1.1 });
        history.pushState(null, '', hash);
      });
    };
    document.head.appendChild(lenisScript);

    // ---- Reveal on scroll (WAAPI so OS reduced-motion cannot leave it hidden)
    const io = new IntersectionObserver((entries) => {
      for (const en of entries) {
        if (!en.isIntersecting) continue;
        const el = en.target as HTMLElement;
        const kind = el.dataset.reveal || 'up';
        const delay = Number(el.dataset.delay || 0);
        // Offsets stay small (and never accumulate on nested [data-reveal] ancestors): larger ones
        // made cards visibly overlap the next card mid-animation when someone scrolls fast.
        const from: Keyframe = kind === 'left' ? { opacity: 0, transform: 'translateX(-12px)' }
          : kind === 'right' ? { opacity: 0, transform: 'translateX(12px)' }
          : kind === 'scale' ? { opacity: 0, transform: 'scale(.975)' }
          : { opacity: 0, transform: 'translateY(8px) scale(.99)' };
        el.style.opacity = '1'; el.style.transform = 'none';
        el.animate([from, { opacity: 1, transform: 'none' }], { duration: 600, delay, easing: 'cubic-bezier(0.22, 1, 0.36, 1)', fill: 'backwards' });
        io.unobserve(el);
      }
    }, { rootMargin: '0px 0px -8% 0px', threshold: 0.06 });
    document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

    // Staggered children: <ul data-stagger> reveals each child in sequence
    const sio = new IntersectionObserver((entries) => {
      for (const en of entries) {
        if (!en.isIntersecting) continue;
        const kids = Array.from((en.target as HTMLElement).children) as HTMLElement[];
        kids.forEach((k, i) => {
          k.style.opacity = '1';
          k.animate([{ opacity: 0, transform: 'translateY(8px) scale(.99)' }, { opacity: 1, transform: 'none' }],
            { duration: 550, delay: Math.min(i, 8) * 55, easing: 'cubic-bezier(0.22, 1, 0.36, 1)', fill: 'backwards' });
        });
        sio.unobserve(en.target);
      }
    }, { rootMargin: '0px 0px -6% 0px', threshold: 0.05 });
    document.querySelectorAll('[data-stagger]').forEach((el) => {
      Array.from(el.children).forEach((k) => ((k as HTMLElement).style.opacity = '0'));
      sio.observe(el);
    });

    // ---- Scroll progress ---------------------------------------------------
    const bar = document.querySelector('.progress') as HTMLElement | null;
    let ticking = false;
    const onScroll = () => {
      if (!bar) return;
      const max = document.documentElement.scrollHeight - innerHeight;
      bar.style.transform = `scaleX(${max > 0 ? Math.min(1, scrollY / max) : 0})`;
      ticking = false;
    };
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(onScroll); } }, { passive: true });
    onScroll();

    // ---- Custom cursor (fine pointers only) --------------------------------
    const cur = document.querySelector('.cursor') as HTMLElement | null;
    if (cur && matchMedia('(pointer: fine)').matches) {
      let cx = 0, cy = 0, tx = 0, ty = 0, shown = false;
      addEventListener('pointermove', (e) => {
        tx = e.clientX; ty = e.clientY;
        if (!shown) { shown = true; cx = tx; cy = ty; cur.classList.add('is-on'); }
        const hot = (e.target as HTMLElement).closest('a, button, [data-tilt], .chip');
        cur.classList.toggle('is-link', !!hot);
      }, { passive: true });
      addEventListener('pointerdown', () => cur.classList.add('is-down'));
      addEventListener('pointerup', () => cur.classList.remove('is-down'));
      document.addEventListener('mouseleave', () => cur.classList.remove('is-on'));
      const loop = () => {
        cx += (tx - cx) * 0.22; cy += (ty - cy) * 0.22;
        cur.style.translate = `${cx}px ${cy}px`;
        requestAnimationFrame(loop);
      };
      loop();
    }

    // ---- Pointer spotlight + tilt cards -----------------------------------
    document.querySelectorAll<HTMLElement>('.spot, [data-tilt]').forEach((el) => {
      const tilt = el.hasAttribute('data-tilt');
      el.addEventListener('pointermove', (e) => {
        const r = el.getBoundingClientRect();
        const x = e.clientX - r.left, y = e.clientY - r.top;
        el.style.setProperty('--mx', `${x}px`);
        el.style.setProperty('--my', `${y}px`);
        if (tilt && matchMedia('(pointer: fine)').matches) {
          const rx = ((y / r.height) - 0.5) * -6;
          const ry = ((x / r.width) - 0.5) * 8;
          el.style.transform = `perspective(900px) rotateX(${rx}deg) rotateY(${ry}deg) translateY(-4px)`;
        }
      });
      el.addEventListener('pointerleave', () => { if (tilt) el.style.transform = ''; });
    });

    // ---- Magnetic buttons ----------------------------------------------------
    if (matchMedia('(pointer: fine)').matches) {
      document.querySelectorAll<HTMLElement>('[data-magnetic]').forEach((el) => {
        el.addEventListener('pointermove', (e) => {
          const r = el.getBoundingClientRect();
          const dx = e.clientX - (r.left + r.width / 2);
          const dy = e.clientY - (r.top + r.height / 2);
          el.style.transform = `translate(${dx * 0.18}px, ${dy * 0.22}px)`;
        });
        el.addEventListener('pointerleave', () => { el.style.transform = ''; });
      });
    }

    // ---- Theme (light/dark) ---------------------------------------------------
    // One entry point for every light/dark switch on the page (nav icon, drawer switch, the
    // picker's mode buttons). Uses the View Transitions API for a real cross-fade of the whole
    // page where available, and the .is-theming property transitions everywhere else.
    const setTheme = (next: 'light' | 'dark') => {
      const root = document.documentElement;
      if (root.dataset.theme === next) return;
      const apply = () => {
        root.dataset.theme = next;
        try { localStorage.setItem('afnet-theme', next); } catch {}
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', next === 'light' ? '#f4f6fb' : '#07090f');
        document.dispatchEvent(new CustomEvent('ov:theme', { detail: { theme: next } }));
      };
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const svt = (document as any).startViewTransition;
      if (!reduced && typeof svt === 'function') {
        root.classList.add('is-theme-vt');
        const vt = svt.call(document, apply);
        vt.finished.finally(() => root.classList.remove('is-theme-vt'));
      } else {
        (window as any).__ovWithThemeTransition ? (window as any).__ovWithThemeTransition(apply) : apply();
      }
    };
    (window as any).__ovSetTheme = setTheme;
    document.addEventListener('click', (e) => {
      const t = (e.target as HTMLElement).closest('[data-theme-toggle]');
      if (!t) return;
      setTheme(document.documentElement.dataset.theme === 'light' ? 'dark' : 'light');
    });

    // ---- Link hover previews ----------------------------------------------------
    // Pre-rendered thumbnails only (see scripts/make-link-previews.mjs) — nothing is fetched
    // live. External links match by host, internal ones by pathname. Links that are already
    // image cards (project tiles) are skipped so the card doesn't duplicate what's under it.
    if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
      const lp = document.getElementById('lp') as HTMLElement;
      const lpImg = lp.querySelector('img') as HTMLImageElement;
      const lpCap = lp.querySelector('.lp__cap span') as HTMLElement;
      const previews: Record<string, { img?: string; label: string }> = JSON.parse(document.getElementById('lp-data')?.textContent || '{}');
      const iconFor = (host: string) => host.includes('github') ? 'fa-brands fa-github' : host.includes('linkedin') ? 'fa-brands fa-linkedin-in' : 'fa-solid fa-arrow-up-right-from-square';
      const keyFor = (a: HTMLAnchorElement) => {
        try {
          const u = new URL(a.href, location.href);
          if (u.origin === location.origin) {
            const p = u.pathname.replace(/\/$/, '') || '/';
            const h = u.hash.replace(/^#/, '');
            if (h && previews['path:' + p + '#' + h]) return 'path:' + p + '#' + h;
            if (h && p === (location.pathname.replace(/\/$/, '') || '/')) return null; // same-page anchor with no shot: nothing useful to show
            return previews['path:' + p] ? 'path:' + p : null;
          }
          const h = u.host.replace(/^www\./, '');
          return previews[h] ? h : (h.includes('linkedin') ? 'linkedin.com' : null);
        } catch { return null; }
      };
      let cur: HTMLAnchorElement | null = null, px = 0, py = 0, cx = 0, cy = 0, lpRaf = 0;
      const place = () => {
        cx += (px - cx) * 0.18; cy += (py - cy) * 0.18;
        const w = lp.offsetWidth || 290, h = lp.offsetHeight || 220;
        let x = cx + 20, y = cy + 22;
        const flip = x + w > innerWidth - 12;
        if (flip) x = cx - w - 20;
        if (y + h > innerHeight - 12) y = cy - h - 18;
        lp.classList.toggle('is-flip', flip);
        lp.style.setProperty('--x', `${Math.max(8, x)}px`); lp.style.setProperty('--y', `${Math.max(8, y)}px`);
        if (cur) lpRaf = requestAnimationFrame(place);
      };
      const hide = () => { cur = null; lp.classList.remove('is-on'); cancelAnimationFrame(lpRaf); };
      document.addEventListener('mousemove', (e) => { px = e.clientX; py = e.clientY; }, { passive: true });
      document.addEventListener('mouseover', (e) => {
        const a = (e.target as HTMLElement).closest('a[href]') as HTMLAnchorElement | null;
        if (!a || a === cur) return;
        if (a.querySelector('img') || a.closest('.nav__drawer, .lp')) return;
        const key = keyFor(a); if (!key) return;
        const p = previews[key] || { label: key };
        cur = a; cx = px; cy = py;
        lp.classList.toggle('lp--noimg', !p.img); lp.classList.remove('is-loaded');
        lpCap.textContent = p.label; (lp.querySelector('.lp__cap i') as HTMLElement).className = iconFor(key);
        if (p.img) { lpImg.onload = () => lp.classList.add('is-loaded'); if (lpImg.src.endsWith(p.img)) lp.classList.add('is-loaded'); else lpImg.src = p.img; }
        lp.classList.add('is-on');
        cancelAnimationFrame(lpRaf); place();
      });
      document.addEventListener('mouseout', (e) => {
        const a = (e.target as HTMLElement).closest('a[href]');
        if (a && a === cur && !a.contains(e.relatedTarget as Node)) hide();
      });
      addEventListener('scroll', hide, { passive: true });
    }

    // ---- Floating scrollbar ---------------------------------------------------
    // The native sbar is hidden (global.css); this overlay one floats above the content, takes no
    // layout space, shows itself while you scroll or approach the right edge, and fades out
    // once input goes quiet. Drag the thumb or click the track like a normal scrollbar.
    const sbar = document.createElement('div');
    sbar.className = 'ovbar';
    sbar.setAttribute('aria-hidden', 'true');
    sbar.innerHTML = '<div class="ovbar__track"><div class="ovbar__thumb"></div></div>';
    document.body.appendChild(sbar);
    const track = sbar.firstElementChild as HTMLElement;
    const thumb = track.firstElementChild as HTMLElement;
    let hideTimer = 0, dragging = false, dragOffset = 0;
    const docH = () => document.documentElement.scrollHeight;
    const layout = () => {
      const vh = innerHeight, dh = docH();
      if (dh <= vh + 2) { sbar.classList.add('is-unneeded'); return; }
      sbar.classList.remove('is-unneeded');
      const th = track.clientHeight;
      const size = Math.max(36, (vh / dh) * th);
      const y = (scrollY / (dh - vh)) * (th - size);
      thumb.style.height = `${size}px`;
      thumb.style.transform = `translateY(${Math.min(Math.max(y, 0), th - size)}px)`;
    };
    const show = () => {
      sbar.classList.add('is-on');
      clearTimeout(hideTimer);
      if (!dragging) hideTimer = setTimeout(() => sbar.classList.remove('is-on'), 1200);
    };
    const scrollToRatio = (r: number, smooth: boolean) => {
      const target = r * (docH() - innerHeight);
      const lenis = (window as any).__lenis;
      if (lenis) lenis.scrollTo(target, { immediate: !smooth, duration: 0.6 });
      else scrollTo({ top: target, behavior: smooth ? 'smooth' : 'auto' });
    };
    addEventListener('scroll', () => { layout(); show(); }, { passive: true });
    addEventListener('resize', layout);
    addEventListener('pointermove', (e) => { if (e.pointerType === 'mouse' && innerWidth - e.clientX < 40) show(); }, { passive: true });
    addEventListener('touchstart', show, { passive: true });
    thumb.addEventListener('pointerdown', (e) => {
      dragging = true; sbar.classList.add('is-dragging');
      dragOffset = e.clientY - thumb.getBoundingClientRect().top;
      thumb.setPointerCapture(e.pointerId);
      e.preventDefault();
    });
    thumb.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const tr = track.getBoundingClientRect();
      const range = tr.height - thumb.offsetHeight;
      scrollToRatio(Math.min(Math.max((e.clientY - tr.top - dragOffset) / range, 0), 1), false);
    });
    const endDrag = () => { if (!dragging) return; dragging = false; sbar.classList.remove('is-dragging'); show(); };
    thumb.addEventListener('pointerup', endDrag);
    thumb.addEventListener('pointercancel', endDrag);
    track.addEventListener('pointerdown', (e) => {
      if (e.target === thumb) return;
      const tr = track.getBoundingClientRect();
      scrollToRatio(Math.min(Math.max((e.clientY - tr.top - thumb.offsetHeight / 2) / (tr.height - thumb.offsetHeight), 0), 1), true);
    });
    new ResizeObserver(layout).observe(document.body);
    layout();
  </script>
</body>
</html>

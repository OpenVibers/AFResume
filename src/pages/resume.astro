---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import profile from "../data/profile.json";
import { linkify } from "../lib/linkify";
import themePdfManifest from "../data/theme-pdf-manifest.json";
import themePresets from "../data/theme-presets.json";

const exp = (await getCollection("experience")).sort((a, b) => a.data.order - b.data.order);
const skills = (await getCollection("skills")).sort((a, b) => a.data.order - b.data.order);
const projects = (await getCollection("projects")).filter((p) => p.data.featured).sort((a, b) => a.data.order - b.data.order).slice(0, 6);
const LINK_TERMS = {
  "OpenVibe": { href: "https://openvibe.network", external: true },
  "PowerChat": { href: "https://powerchat.live", external: true },
};
const pitchParts = linkify(profile.pitch, LINK_TERMS);
---
<Base title="Resume — Alex Frison" description="Resume of Alex Frison: software engineer, platform architect and founder of OpenVibe. Contract engineer at PowerChat. Formerly Amazon ICQA analytics.">
  <article class="resume container">
    <header class="resume__head" data-reveal>
      <div>
        <div class="eyebrow">Resume · September 2026</div>
        <h1>{profile.name}</h1>
        <p class="resume__sub">Software Engineer · Platform Architect · Founder of OpenVibe</p>
        <p class="resume__avail"><span class="live-dot"></span> {profile.availability}</p>
      </div>
      <div class="resume__contact">
        <a href={`mailto:${profile.email}`}><i class="fa-solid fa-envelope"></i> {profile.emailDisplay}</a>
        <a href={`tel:${profile.phone}`}><i class="fa-solid fa-phone"></i> {profile.phoneDisplay}</a>
        <a href={profile.site}><i class="fa-solid fa-globe"></i> {profile.siteDisplay}</a>
        <a href={profile.linkedin} target="_blank" rel="noopener"><i class="fa-brands fa-linkedin"></i> {profile.linkedinDisplay}</a>
        <a href={profile.github} target="_blank" rel="noopener"><i class="fa-brands fa-github"></i> {profile.githubDisplay}</a>
        <span><i class="fa-solid fa-location-dot"></i> {profile.locationShort}</span>
      </div>
    </header>

    <div class="resume__actions" data-reveal>
      <a href={profile.resumePdf} class="btn btn--primary" data-magnetic><i class="fa-solid fa-file-pdf"></i> Download PDF</a>
      <button type="button" class="btn" id="themed-pdf-toggle" data-magnetic aria-expanded="false" aria-controls="themed-pdf-swatches">
        <i class="fa-solid fa-paintbrush"></i> Themed PDF <i class="fa-solid fa-chevron-down themed-pdf-caret" aria-hidden="true"></i>
      </button>
      <button onclick="window.print()" class="btn" data-magnetic><i class="fa-solid fa-print"></i> Print this page</button>
    </div>
    <p class="resume__pdf-note">The <strong>Download PDF</strong> is the canonical résumé — dense and ATS-safe. <strong>Themed PDF</strong> is the same content, pre-built in whichever color you pick below (every color is generated ahead of time, nothing renders in your browser).</p>

    <div class="themed-pdf-swatches" id="themed-pdf-swatches" hidden>
      {themePresets.map((p) => (
        <a href={themePdfManifest[p.name]} class="themed-pdf-swatch" style={`--sw:${p.hex}`} title={`Download in ${p.label}`} aria-label={`Download résumé PDF themed in ${p.label}`} data-magnetic></a>
      ))}
    </div>

    <section class="resume__sec" data-reveal>
      <h2>Profile</h2>
      <p class="resume__pitch">{pitchParts.map((p) => typeof p === "string" ? p : <a href={p.href} target={p.external ? "_blank" : undefined} rel={p.external ? "noopener" : undefined}>{p.text}</a>)}</p>
    </section>

    <section class="resume__sec" data-reveal>
      <h2>Experience</h2>
      {exp.map((e) => (
        <div class="job">
          <div class="job__head">
            <div>
              <strong class="job__role">{e.data.role}</strong>
              <div class="job__co">{e.data.link ? <a href={e.data.link} target="_blank" rel="noopener">{e.data.company}</a> : e.data.company}{e.data.location ? ` · ${e.data.location}` : ""}</div>
            </div>
            <span class="job__when mono">{e.data.current && <span class="live-dot"></span>}{e.data.start} — {e.data.end}</span>
          </div>
          {e.data.summary && <p class="job__sum">{e.data.summary}</p>}
          <ul>{e.data.bullets.map((b) => <li>{b}</li>)}</ul>
          {e.data.stack.length > 0 && <p class="job__stack">{e.data.stack.join(" · ")}</p>}
        </div>
      ))}
    </section>

    <section class="resume__sec" data-reveal>
      <h2>Selected work</h2>
      <ul class="resume__projects">
        {projects.map((p) => (
          <li>
            <a href={`/portfolio/${p.slug}`}><strong>{p.data.title}</strong></a>
            <span>{p.data.summary}</span>
            {p.data.links?.live && <a class="mono resume__url" href={p.data.links.live} target="_blank" rel="noopener">{p.data.links.live.replace(/^https?:\/\//, "")}</a>}
          </li>
        ))}
      </ul>
    </section>

    <section class="resume__sec" data-reveal>
      <h2>Skills</h2>
      <div class="resume__skills">
        {skills.map((g) => (
          <div>
            <h3>{g.data.group}</h3>
            <p>{g.data.items.map((i) => i.name).join(" · ")}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="resume__sec" data-reveal>
      <h2>Education</h2>
      <p>{profile.education}</p>
    </section>
  </article>
</Base>

<style>
  .resume { padding: calc(var(--nav-h) + 40px) var(--gutter) 90px; max-width: 920px; }
  .resume__head { display: grid; grid-template-columns: 1fr auto; align-items: end; gap: 24px; padding-bottom: 26px; border-bottom: 1px solid var(--border); }
  @media (max-width: 720px) { .resume__head { grid-template-columns: 1fr; } }
  .resume__head h1 { font-size: clamp(2.4rem, 6vw, 3.6rem); margin: .2em 0 .1em; }
  .resume__sub { color: var(--fg); font-weight: 600; margin: 0 0 8px; }
  .resume__avail { display: inline-flex; align-items: center; gap: 10px; font-size: .88rem; color: var(--muted); margin: 0; max-width: 46ch; }
  .resume__contact { display: grid; gap: 6px; font-size: .9rem; color: var(--muted); text-align: right; }
  .resume__contact a, .resume__contact span { display: inline-flex; align-items: center; gap: 8px; justify-content: flex-end; color: var(--muted); }
  .resume__contact a:hover { color: var(--accent); text-decoration: none; }
  .resume__contact i { color: var(--accent); width: 14px; }
  .resume__actions { display: flex; gap: 10px; flex-wrap: wrap; padding: 22px 0 6px; }
  @media (max-width: 560px) { .resume__actions { display: grid; grid-template-columns: 1fr; } .resume__actions > .btn { justify-content: center; } }
  .resume__pdf-note { font-size: .82rem; color: var(--dim); max-width: 62ch; margin: 0 0 8px; }
  .resume__pdf-note strong { color: var(--muted); }
  .themed-pdf-caret { font-size: .68em; transition: transform .3s var(--ease); }
  #themed-pdf-toggle[aria-expanded="true"] .themed-pdf-caret { transform: rotate(180deg); }
  .themed-pdf-swatches {
    display: flex; flex-wrap: wrap; gap: 10px; margin: 4px 0 20px; padding: 14px;
    border-radius: 16px; border: 1px dashed var(--border-strong); background: var(--surface);
  }
  .themed-pdf-swatches[hidden] { display: none; }
  /* Phones: twelve swatches as two even rows of six instead of seven and five. */
  @media (max-width: 560px) { .themed-pdf-swatches:not([hidden]) { display: grid; grid-template-columns: repeat(6, 1fr); justify-items: center; } }
  .themed-pdf-swatch {
    width: 34px; height: 34px; border-radius: 50%; background: var(--sw);
    border: 2px solid transparent; box-shadow: inset 0 0 0 1px rgba(0,0,0,.1);
    transition: transform .2s var(--ease), box-shadow .2s var(--ease);
  }
  .themed-pdf-swatch:hover { transform: scale(1.15) translateY(-2px); box-shadow: 0 6px 16px -4px var(--sw), inset 0 0 0 1px rgba(0,0,0,.1); }
  .resume__sec { padding: 26px 0; border-top: 1px solid var(--border); }
  .resume__sec:first-of-type { border-top: 0; }
  .resume__sec h2 { font-family: var(--font-mono); font-size: .78rem; letter-spacing: .22em; text-transform: uppercase; color: var(--accent); margin-bottom: 1.1rem; display: flex; align-items: center; gap: 12px; }
  .resume__sec h2::after { content: ""; flex: 1; height: 1px; background: var(--border); }
  .resume__pitch { font-size: 1.05rem; color: var(--fg); line-height: 1.75; }
  .job { margin-bottom: 1.6rem; }
  .job__head { display: flex; justify-content: space-between; gap: 14px; flex-wrap: wrap; align-items: flex-start; }
  .job__role { color: var(--fg); font-size: 1.08rem; font-family: var(--font-display); }
  .job__co { color: var(--muted); font-size: .92rem; margin-top: 2px; }
  .job__co a { color: var(--fg); font-weight: 600; }
  .job__when { display: inline-flex; align-items: center; gap: 8px; color: var(--dim); font-size: .8rem; letter-spacing: .06em; white-space: nowrap; }
  .job__sum { font-style: italic; color: var(--muted); font-size: .92rem; margin: .6rem 0 .4rem; }
  .job ul { margin: .5rem 0 0; padding-left: 1.2rem; color: var(--muted); line-height: 1.65; font-size: .95rem; display: grid; gap: 6px; }
  .job li::marker { color: var(--accent-2); }
  .job__stack { font-family: var(--font-mono); font-size: .74rem; color: var(--dim); margin: .7rem 0 0; }
  .resume__projects { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 14px 24px; }
  .resume__projects li { display: grid; gap: 3px; font-size: .92rem; color: var(--muted); padding: 12px 14px; border: 1px solid var(--border); border-radius: 12px; background: var(--surface); }
  .resume__projects strong { color: var(--fg); }
  .resume__url { font-size: .74rem; color: var(--accent); }
  .resume__skills { display: grid; grid-template-columns: 1fr 1fr; gap: 14px 24px; }
  .resume__skills h3 { font-family: var(--font-mono); font-size: .76rem; color: var(--fg); text-transform: uppercase; letter-spacing: .1em; margin: 0 0 .3rem; }
  .resume__skills p { margin: 0; font-size: .92rem; }
  @media (max-width: 640px) { .resume__skills, .resume__projects { grid-template-columns: 1fr; } .resume__contact { text-align: left; } .resume__contact a, .resume__contact span { justify-content: flex-start; } }

  @media print {
    :root { --bg: #fff; --fg: #000; --muted: #222; --dim: #444; --border: #ccc; --accent: #1d4ed8; --accent-2: #000; --surface: transparent; }
    html, body { background: #fff !important; }
    .resume { padding: 0; max-width: 100%; }
    .resume__actions, .live-dot, .themed-pdf-swatches, .resume__pdf-note { display: none !important; }
    .resume__sec { break-inside: avoid; padding: 14px 0; }
    .job { break-inside: avoid; }
    a { color: #000; }
  }
</style>

<script>
  // The swatches are pre-built static files (resume/build_resume.py generates one PDF per
  // src/data/theme-presets.json entry ahead of time) — this just shows/hides the row, no PDF
  // generation happens in the browser.
  const toggle = document.getElementById('themed-pdf-toggle');
  const swatches = document.getElementById('themed-pdf-swatches');
  toggle?.addEventListener('click', () => {
    const open = swatches?.hasAttribute('hidden');
    if (open) swatches?.removeAttribute('hidden'); else swatches?.setAttribute('hidden', '');
    toggle.setAttribute('aria-expanded', String(!!open));
  });
</script>
